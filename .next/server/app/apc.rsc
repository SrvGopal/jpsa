11:["$","$1","c",{"children":[["$","main",null,{"className":"container page","children":[["$","div",null,{"className":"eyebrow","children":"PUBLICATION INFORMATION"}],["$","h1",null,{"children":"Article Processing Charges"}],["$","p",null,{"className":"lead","children":"The Journal of Physical Sciences Advances (JPSA) aims to maintain a transparent and accessible publication process. Article Processing Charges (APCs), where applicable, support the editorial and technical activities involved in preparing accepted manuscripts for publication."}],["$","section",null,{"className":"prose","children":[["$","h2",null,{"children":"1. Article Processing Charge Policy"}],["$","p",null,{"children":"JPSA proposes a publication charge structure based on the author's billing location, manuscript length and article category. The applicable charge is communicated to the corresponding author following formal acceptance of the manuscript."}],["$","p",null,{"children":"No payment is required at the time of submission or during peer review. Manuscripts are evaluated on their scientific merit and editorial suitability, independently of the author's ability or willingness to pay publication charges."}],["$","h2",null,{"children":"2. Article Processing Charges"}],["$","p",null,{"children":"JPSA proposes separate publication charges for Indian and international authors. The applicable charge is determined by the article category and manuscript length. Payment is requested only after formal acceptance."}],["$","div",null,{"className":"apc-rate-grid","children":[["$","div",null,{"className":"apc-rate-card","children":[["$","div",null,{"className":"apc-rate-header","children":[["$","span",null,{"className":"apc-rate-label","children":"INDIAN AUTHORS"}],["$","h3",null,{"children":"Authors based in India"}],["$","p",null,{"children":"Publication charges in Indian Rupees (INR)"}]]}],["$","div",null,{"className":"apc-rate-list","children":[["$","div",null,{"className":"apc-rate-item","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Research Article"}],["$","span",null,{"children":"Up to 10 pages"}]]}],["$","strong",null,{"className":"apc-price","children":"₹3,000"}]]}],["$","div",null,{"className":"apc-rate-item","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Research Article"}],["$","span",null,{"children":"11–15 pages"}]]}],["$","strong",null,{"className":"apc-price","children":"₹4,000"}]]}],["$","div",null,{"className":"apc-rate-item","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Review Article"}],["$","span",null,{"children":"20 pages or more"}]]}],["$","strong",null,{"className":"apc-price","children":"₹5,000"}]]}]]}],["$","p",null,{"className":"apc-rate-note","children":"Rates for other manuscript lengths will be communicated after the fee structure is formally approved."}]]}],["$","div",null,{"className":"apc-rate-card","children":[["$","div",null,{"className":"apc-rate-header","children":[["$","span",null,{"className":"apc-rate-label","children":"INTERNATIONAL AUTHORS"}],["$","h3",null,{"children":"Authors based outside India"}],["$","p",null,{"children":"Publication charges in United States Dollars (USD)"}]]}],["$","div",null,{"className":"apc-rate-list","children":[["$","div",null,{"className":"apc-rate-item","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Research Article"}],["$","span",null,{"children":"Up to 15 pages"}]]}],["$","strong",null,{"className":"apc-price","children":"$$50"}]]}],["$","div",null,{"className":"apc-rate-item","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Research Article"}],["$","span",null,{"children":"More than 15 pages"}]]}],["$","strong",null,{"className":"apc-price","children":"$$75"}]]}],["$","div",null,{"className":"apc-rate-item","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Review Article"}],["$","span",null,{"children":"All review articles"}]]}],["$","strong",null,{"className":"apc-price","children":"$$100"}]]}]]}],["$","p",null,{"className":"apc-rate-note","children":"The review-article category takes precedence over the regular research-article page-based rates."}]]}]]}],["$","h2",null,{"children":"4. What the APC Covers"}],["$","p",null,{"children":"Article Processing Charges are intended to support the activities associated with the editorial preparation and publication of accepted manuscripts. Depending on the services provided by the journal, these activities may include:"}],"$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39"]}]]}],null,"$L3a"]}]
