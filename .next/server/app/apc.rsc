14:["$","ul",null,{"children":[["$","li",null,{"children":"Editorial and publication administration."}],["$","li",null,{"children":"Manuscript preparation and formatting."}],["$","li",null,{"children":"Copyediting and language-related corrections."}],["$","li",null,{"children":"Typesetting and preparation of publication files."}],["$","li",null,{"children":"Online publication and website hosting."}],["$","li",null,{"children":"DOI registration and publication metadata, where applicable."}],["$","li",null,{"children":"Digital archiving and preservation arrangements."}]]}]
15:["$","p",null,{"children":"The APC does not represent a payment for acceptance, favourable peer review or guaranteed publication."}]
16:["$","h2",null,{"children":"5. When Is the APC Payable?"}]
17:["$","p",null,{"children":"The APC is payable only after a manuscript has received formal acceptance following the applicable editorial assessment and peer review process."}]
18:["$","p",null,{"children":"Authors should wait for an official acceptance communication and payment instructions from the editorial office before making any payment. No APC is payable for a manuscript that has been rejected."}]
19:["$","p",null,{"children":"Payment of the APC is required to proceed with publication where the charge applies, unless a full waiver has been formally approved."}]
1a:["$","h2",null,{"children":"6. Waiver and Discount Eligibility"}]
1b:["$","p",null,{"children":"JPSA recognises that publication costs may create difficulties for researchers who do not have institutional funding or adequate financial support. Authors may therefore request a full or partial waiver of the applicable APC."}]
1c:["$","p",null,{"children":"Waiver requests may be considered under the following circumstances:"}]
1d:["$","ul",null,{"children":[["$","li",null,{"children":"Authors based in low-income or lower-middle-income countries who face significant financial constraints."}],["$","li",null,{"children":"Students and early-career researchers without access to institutional or research funding."}],["$","li",null,{"children":"Authors whose research has received no grant, institutional or other financial support."}],["$","li",null,{"children":"Researchers from institutions with limited resources and no available publication budget."}],["$","li",null,{"children":"Authors experiencing exceptional financial or institutional circumstances."}]]}]
1e:["$","p",null,{"children":"Eligibility for consideration does not guarantee approval. Each request will be evaluated individually, taking into account the circumstances explained by the corresponding author."}]
1f:["$","h2",null,{"children":"7. Requesting a Waiver"}]
20:["$","p",null,{"children":"Authors seeking a full or partial waiver should submit a written request to the editorial office. The request should preferably be made at the time of manuscript submission or before the manuscript receives an editorial decision."}]
21:["$","p",null,{"children":"The request should briefly explain the financial circumstances, funding availability and reason for seeking assistance. Supporting information may be requested where necessary."}]
22:["$","p",null,{"children":"Waiver decisions should be communicated independently of the scientific evaluation of the manuscript. Authors should not assume that a waiver has been granted until they receive written confirmation."}]
23:["$","h2",null,{"children":"8. Editorial Independence"}]
24:["$","p",null,{"children":"The ability or inability of an author to pay an APC must not influence the scientific assessment of a manuscript or the editorial decision."}]
25:["$","p",null,{"children":"Editors and reviewers should evaluate submissions according to their originality, scientific quality, relevance and compliance with the journal's publication policies. Payment must not guarantee acceptance, accelerate peer review or influence reviewer recommendations."}]
26:["$","h2",null,{"children":"9. Payment Procedure and Receipt"}]
27:["$","p",null,{"children":"Following acceptance, the corresponding author will receive the applicable APC amount and official payment instructions from the journal. Authors should make payments only through payment channels formally authorised by JPSA."}]
28:["$","p",null,{"children":"The corresponding author should retain proof of payment and provide transaction details when requested. An official acknowledgement or receipt should be issued for verified payments."}]
29:["$","p",null,{"children":"Authors should not transfer publication charges to personal bank accounts or unofficial payment recipients."}]
2a:["$","h2",null,{"children":"10. Taxes and Currency"}]
2b:["$","p",null,{"children":"Indian authors will be quoted charges in Indian Rupees (INR), while international authors will be quoted charges in United States Dollars (USD)."}]
2c:["$","p",null,{"children":"Applicable taxes, including GST where legally required, will be communicated transparently before payment. Any applicable international transaction or currency conversion charges imposed by payment providers or banks may be borne by the payer."}]
2d:["$","h2",null,{"children":"11. Refund Policy"}]
2e:["$","p",null,{"children":"APC payments are associated with the processing and publication of accepted manuscripts. Refund requests will be considered in accordance with the circumstances of the payment."}]
2f:["$","p",null,{"children":"Duplicate payments, excess payments and payments made in error may be reviewed for correction or refund after verification."}]
30:["$","p",null,{"children":"Where a manuscript is withdrawn after acceptance, the corresponding author should contact the editorial office. Any refund will be considered on a case-by-case basis, taking into account the publication work already completed and the journal's approved refund terms."}]
31:["$","h2",null,{"children":"12. No Additional Undisclosed Charges"}]
32:["$","p",null,{"children":"JPSA should communicate all mandatory publication charges to authors before payment. Authors should not be asked to pay undisclosed fees for submission, peer review or editorial acceptance."}]
33:["$","p",null,{"children":"Any additional optional services or charges, if introduced, must be communicated separately and clearly identified as optional."}]
34:["$","h2",null,{"children":"13. Changes to APC Rates"}]
35:["$","p",null,{"children":"The journal reserves the right to review its publication charges in response to changes in publication and operational costs. Any revised fee structure should be published on the official journal website with its effective date."}]
36:["$","p",null,{"children":"Authors should be informed of the applicable charges before they proceed with payment."}]
37:["$","h2",null,{"children":"Related information"}]
38:["$","p",null,{"children":"Authors are encouraged to review the following information before submitting their manuscripts:"}]
39:["$","ul",null,{"children":[["$","li",null,{"children":["$","$L2",null,{"href":"/authors/guidelines","children":"Author Guidelines"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/authors/manuscript-preparation","children":"Manuscript Preparation"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/authors/peer-review","children":"Peer Review Process"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/authors/submission-process","children":"Submission Process"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/policies/publication-ethics","children":"Publication Ethics"}]}]]}]
