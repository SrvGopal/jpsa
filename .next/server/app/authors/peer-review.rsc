16:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Accept:"}]," The manuscript is considered suitable for publication, subject to any remaining editorial or production requirements."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Minor Revision:"}]," Limited corrections or clarifications are required before further consideration."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Major Revision:"}]," Substantial changes or additional explanations are required."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Reject:"}]," The manuscript is not considered suitable for publication in the journal."]}]]}]
17:["$","h2",null,{"children":"7. Revision and author response"}]
18:["$","p",null,{"children":"When revision is requested, authors should carefully consider the comments provided by the reviewers and editor. A revised manuscript should be accompanied by a response explaining how each comment has been addressed."}]
19:["$","p",null,{"children":"Where authors disagree with a particular recommendation, they should provide a clear and scientifically reasoned explanation. Revised manuscripts may be returned to the original reviewers or assessed by the editor, as appropriate."}]
1a:["$","h2",null,{"children":"8. Responsibilities of reviewers"}]
1b:["$","p",null,{"children":"Reviewers are expected to conduct their evaluations objectively, professionally and within their area of expertise. They should:"}]
1c:["$","ul",null,{"children":[["$","li",null,{"children":"Maintain the confidentiality of submitted manuscripts."}],["$","li",null,{"children":"Provide constructive and evidence-based comments."}],["$","li",null,{"children":"Disclose any potential competing interests."}],["$","li",null,{"children":"Identify relevant published work that may have been overlooked."}],["$","li",null,{"children":"Report suspected ethical concerns to the editor."}],["$","li",null,{"children":"Avoid using unpublished information for personal advantage."}]]}]
1d:["$","h2",null,{"children":"9. Confidentiality and editorial independence"}]
1e:["$","p",null,{"children":"Manuscripts and communications received during the review process should be treated as confidential. Reviewers and editors must not disclose unpublished material or use information obtained through review for purposes unrelated to their editorial responsibilities."}]
1f:["$","p",null,{"children":"Editorial decisions should be based on scientific merit, relevance and compliance with journal policies. Personal, institutional or commercial considerations should not improperly influence the evaluation of submitted work."}]
20:["$","h2",null,{"children":"10. Review timelines"}]
21:["$","p",null,{"children":"The duration of the review process may vary depending on reviewer availability, manuscript complexity, subject area and the extent of revisions required. The journal aims to process submissions as efficiently as reasonably possible."}]
22:["$","p",null,{"children":"Authors should understand that a specific review duration cannot be guaranteed unless formally communicated by the editorial office."}]
23:["$","h2",null,{"children":"11. Appeals and concerns"}]
24:["$","p",null,{"children":"Authors who believe that an editorial decision involved a significant procedural error or a misunderstanding of the scientific content may submit a reasoned appeal to the editorial office. Appeals should identify the specific grounds for reconsideration and provide supporting explanations."}]
25:["$","p",null,{"children":"An appeal does not guarantee reversal of the original decision. The matter should be considered in accordance with the journal's editorial procedures and publication ethics requirements."}]
26:["$","h2",null,{"children":"12. Review process and publication ethics"}]
27:["$","p",null,{"children":"The peer review process operates in conjunction with the journal's publication ethics requirements. Concerns involving plagiarism, authorship, competing interests or research misconduct should be handled under the applicable journal policies."}]
28:["$","h2",null,{"children":"Related information"}]
29:["$","p",null,{"children":"Authors should also consult:"}]
