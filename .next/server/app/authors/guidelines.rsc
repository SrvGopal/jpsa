13:["$","$1","c",{"children":[["$","main",null,{"className":"container page","children":[["$","div",null,{"className":"eyebrow","children":"INFORMATION FOR CONTRIBUTORS"}],["$","h1",null,{"children":"Author Guidelines"}],["$","p",null,{"className":"lead","children":"These guidelines describe the general expectations for preparing scholarly manuscripts for consideration by the Journal of Physical Sciences Advances."}],["$","div",null,{"className":"notice","children":[["$","strong",null,{"children":"Important publication information"}],["$","p",null,{"children":"These guidelines are a working version. The journal must formally approve its manuscript template, article-specific requirements, publication charges and final submission policies before accepting manuscripts."}]]}],["$","section",null,{"className":"prose","children":[["$","h2",null,{"children":"1. Scope and suitability"}],["$","p",null,{"children":"Manuscripts should address relevant topics in physics and the physical sciences, including theoretical, experimental, computational and interdisciplinary research."}],["$","p",null,{"children":"Authors should consult the journal's aims and scope before submitting their work."}],["$","h2",null,{"children":"2. Originality and exclusive submission"}],["$","p",null,{"children":"Submitted work should be original and should not be under consideration by another journal at the same time. Previously published material must be clearly identified and appropriately cited."}],["$","p",null,{"children":"Authors must disclose substantial overlap with their previous publications, preprints or related manuscripts."}],["$","h2",null,{"children":"3. Manuscript structure"}],["$","p",null,{"children":"Research manuscripts should normally contain the following elements, where appropriate to the article type:"}],["$","ol",null,{"children":[["$","li",null,{"children":"Title of the manuscript."}],["$","li",null,{"children":"Full names of all authors."}],["$","li",null,{"children":"Institutional affiliations and corresponding author details."}],["$","li",null,{"children":"Abstract summarizing the work."}],["$","li",null,{"children":"Keywords describing the research."}],["$","li",null,{"children":"Introduction and research background."}],["$","li",null,{"children":"Methods, theoretical framework or experimental details."}],["$","li",null,{"children":"Results and discussion."}],["$","li",null,{"children":"Conclusion."}],["$","li",null,{"children":"Acknowledgements, declarations and references."}]]}],["$","p",null,{"children":"The exact structure may vary for review articles, theoretical papers, short communications and other approved article categories."}],["$","h2",null,{"children":"4. Authors and affiliations"}],["$","p",null,{"children":"Every listed author should have made a meaningful contribution to the research and should approve the submitted version of the manuscript."}],["$","p",null,{"children":"The corresponding author is responsible for coordinating communication with the editorial office and confirming that all co-authors approve submission and publication."}],["$","h2",null,{"children":"5. Abstract and keywords"}],["$","p",null,{"children":"The abstract should clearly communicate the research objective, approach, principal findings and significance. It should be understandable without requiring readers to consult the full manuscript."}],["$","p",null,{"children":"Authors should provide relevant keywords that accurately represent the subject of the work. The final word limits and keyword limits will be specified in the approved journal template."}],["$","h2",null,{"children":"6. Figures, tables and equations"}],["$","ul",null,{"children":[["$","li",null,{"children":"Number figures and tables consistently."}],["$","li",null,{"children":"Provide descriptive captions and titles."}],["$","li",null,{"children":"Refer to every figure and table in the manuscript text."}],"$L16","$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d"]}]]}],null,"$L2e"]}]
