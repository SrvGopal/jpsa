16:["$","li",null,{"children":"Use clear, readable labels and appropriate units."}]
17:["$","li",null,{"children":"Identify the source of material reproduced from elsewhere."}]
18:["$","li",null,{"children":"Use consistent equation numbering where applicable."}]
19:["$","h2",null,{"children":"7. References and citations"}]
1a:["$","p",null,{"children":"Every source cited in the manuscript should appear in the reference list, and every listed reference should be cited in the text."}]
1b:["$","p",null,{"children":"Authors should provide accurate bibliographic information, including DOI identifiers where available. The journal's final reference style must be followed once formally specified."}]
1c:["$","h2",null,{"children":"8. Research ethics and declarations"}]
1d:["$","p",null,{"children":"Authors are expected to disclose information relevant to the integrity and transparency of their research. Depending on the manuscript, this may include:"}]
1e:["$","ul",null,{"children":[["$","li",null,{"children":"Funding and financial support."}],["$","li",null,{"children":"Conflicts of interest."}],["$","li",null,{"children":"Author contributions."}],["$","li",null,{"children":"Data availability."}],["$","li",null,{"children":"Ethical approval, where applicable."}],["$","li",null,{"children":"Permissions for reproduced material."}]]}]
1f:["$","p",null,{"children":"Authors must not fabricate, falsify or improperly manipulate research data, results or images."}]
20:["$","h2",null,{"children":"9. Editorial screening and peer review"}]
21:["$","p",null,{"children":"Submitted manuscripts undergo an initial editorial assessment for suitability and completeness. Manuscripts considered suitable may proceed to the journal's peer-review process."}]
22:["$","p",null,{"children":"Editorial decisions may include acceptance, rejection or a request for revision. Submission does not guarantee acceptance or publication."}]
23:["$","h2",null,{"children":"10. Publication charges"}]
24:["$","p",null,{"children":"If an Article Processing Charge applies, the journal should communicate the approved amount, currency, applicable taxes, payment instructions and refund conditions to authors transparently."}]
25:["$","p",null,{"children":"Any applicable publication charge is separate from editorial evaluation. Payment must not guarantee acceptance, influence peer review or override an editorial decision."}]
26:["$","p",null,{"children":"Authors should receive an appropriate payment acknowledgement or receipt for verified transactions."}]
27:["$","h2",null,{"children":"11. Corrections and post-publication matters"}]
28:["$","p",null,{"children":"Authors should promptly notify the editorial office if they discover a significant error in their published work. Corrections, expressions of concern and retractions should be handled under the journal's applicable publication ethics policies."}]
29:["$","h2",null,{"children":"12. Submission status"}]
2a:["$","div",null,{"className":"notice","children":[["$","strong",null,{"children":"Submission portal not yet available"}],["$","p",null,{"children":"The online submission and manuscript tracking system is under development. These guidelines do not constitute an active submission channel."}]]}]
2b:["$","h2",null,{"children":"Related information"}]
2c:["$","p",null,{"children":"Authors should also review the following resources:"}]
