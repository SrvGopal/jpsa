16:["$","article","References",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["SECTION ","08"]}],["$","h3",null,{"children":"References"}],["$","p",null,{"children":"Include complete and accurate bibliographic details for all works cited in the manuscript. Every in-text citation should correspond to an entry in the reference list."}]]}]
17:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Formatting and Presentation"}],["$","p",null,{"children":"Manuscripts should be consistently formatted and presented in a readable academic style. Authors should pay particular attention to the following elements:"}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Language and presentation",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Language and presentation"}],["$","p",null,{"children":"Manuscripts should be written in clear, formal scientific English. Authors should check grammar, terminology, notation and consistency before submission."}]]}],["$","article","Equations and mathematical notation",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Equations and mathematical notation"}],["$","p",null,{"children":"Equations should be created using an appropriate equation editor or equivalent typesetting method. Symbols, variables and abbreviations should be defined when first introduced."}]]}],["$","article","Figures and illustrations",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Figures and illustrations"}],["$","p",null,{"children":"Figures should be relevant, clearly labelled and of sufficient resolution for publication. Each figure must have a descriptive caption and should be cited in the manuscript."}]]}],["$","article","Tables",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Tables"}],["$","p",null,{"children":"Tables should have descriptive titles, clearly identified columns and appropriate units. Avoid presenting the same information in both a table and a figure unless necessary."}]]}],["$","article","Units and symbols",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Units and symbols"}],["$","p",null,{"children":"Use standard scientific notation and internationally recognised units wherever applicable. Maintain consistent notation throughout the manuscript."}]]}],["$","article","Abbreviations",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Abbreviations"}],["$","p",null,{"children":"Define abbreviations at their first occurrence and use them consistently throughout the manuscript. Avoid introducing abbreviations that are not necessary."}]]}]]}]]}]
18:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Research Data and Reproducibility"}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"Authors should provide sufficient information about the data, methods, calculations and experimental conditions used in their research to allow readers to understand and evaluate the reported findings."}],["$","p",null,{"children":"Where relevant, authors are encouraged to make supporting datasets, computational codes, supplementary calculations and other research materials available through appropriate repositories or as supplementary files."}],["$","p",null,{"children":"Any restrictions on access to research data should be explained clearly."}]]}]]}]
19:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"References and Citations"}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"All sources used in the preparation of a manuscript must be acknowledged through appropriate citations. Authors are responsible for checking the accuracy and completeness of their references."}],["$","p",null,{"children":"References should be presented consistently throughout the manuscript. Authors should ensure that cited works are relevant and that the original sources have been consulted wherever possible."}]]}]]}]
1a:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Figures, Tables and Supplementary Material"}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"Figures, tables and supplementary files should be numbered consistently and referred to in the main text. Captions should explain the content sufficiently for readers to understand the material."}],["$","p",null,{"children":"Authors must have the necessary rights and permissions to use third-party figures, photographs, datasets or other copyrighted material included in their submissions."}]]}]]}]
1b:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Before Submission"}],["$","p",null,{"children":"Authors should check that:"}],["$","ul",null,{"children":[["$","li",null,{"children":"The manuscript falls within the scope of JPSA."}],["$","li",null,{"children":"The work is original and is not under consideration elsewhere."}],["$","li",null,{"children":"All authors have reviewed and approved the submitted version."}],["$","li",null,{"children":"Author details and affiliations are accurate."}],["$","li",null,{"children":"Figures, tables, equations and references are complete."}],["$","li",null,{"children":"Required declarations and supporting files are prepared."}],["$","li",null,{"children":"Permissions have been obtained for any third-party material."}]]}]]}]
