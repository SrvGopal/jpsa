13:["$","$1","c",{"children":[["$","div",null,{"className":"container page journal-content-page","children":[["$","div",null,{"className":"eyebrow","children":"AUTHOR GUIDELINES"}],["$","h1",null,{"children":"Manuscript Preparation"}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Preparing Your Manuscript"}],["$","div",null,{"className":"prose","children":["$","p",null,{"children":"Authors submitting manuscripts to the Journal of Physical Science Advances (JPSA) are expected to prepare their work in a clear, organised and scientifically rigorous manner. A well-prepared manuscript helps editors and reviewers assess the quality, originality and relevance of the research. Authors should ensure that the manuscript is complete, properly structured, appropriately referenced and consistent with the journal's subject scope before beginning the submission process."}]}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Recommended Manuscript Structure"}],["$","p",null,{"children":"Research manuscripts should generally follow the structure below, where appropriate to the article type and nature of the research."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Title",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["SECTION ","01"]}],["$","h3",null,{"children":"Title"}],["$","p",null,{"children":"The title should be concise, informative and accurately reflect the central subject of the research. Avoid unnecessary abbreviations and overly broad statements."}]]}],["$","article","Abstract",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["SECTION ","02"]}],["$","h3",null,{"children":"Abstract"}],["$","p",null,{"children":"Provide a self-contained summary of the research objective, methodology, principal findings and conclusions. The abstract should allow readers to understand the contribution without consulting the full manuscript."}]]}],["$","article","Keywords",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["SECTION ","03"]}],["$","h3",null,{"children":"Keywords"}],["$","p",null,{"children":"Provide relevant keywords that represent the principal concepts, methods and subject areas of the work. Choose terms that will help readers discover the article."}]]}],["$","article","Introduction",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["SECTION ","04"]}],["$","h3",null,{"children":"Introduction"}],["$","p",null,{"children":"Introduce the research problem, explain its scientific background, identify the relevant research gap and state the objectives of the study."}]]}],["$","article","Methodology",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["SECTION ","05"]}],["$","h3",null,{"children":"Methodology"}],["$","p",null,{"children":"Describe the theoretical framework, experimental procedures, computational methods, materials, instruments and analytical techniques in sufficient detail to support evaluation and reproducibility."}]]}],["$","article","Results and Discussion",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["SECTION ","06"]}],["$","h3",null,{"children":"Results and Discussion"}],["$","p",null,{"children":"Present the principal findings clearly and interpret them in relation to the research objectives and relevant published work. Figures, tables and equations should support the discussion rather than duplicate it."}]]}],["$","article","Conclusion",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["SECTION ","07"]}],["$","h3",null,{"children":"Conclusion"}],["$","p",null,{"children":"Summarise the principal findings, explain their scientific significance and identify relevant limitations or possible directions for further research."}]]}],"$L16"]}]]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c"]}],null,"$L1d"]}]
