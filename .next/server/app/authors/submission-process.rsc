13:["$","$1","c",{"children":[["$","main",null,{"className":"container page","children":[["$","div",null,{"className":"eyebrow","children":"INFORMATION FOR AUTHORS"}],["$","h1",null,{"children":"Submission Process"}],["$","p",null,{"className":"lead","children":"The Journal of Physical Sciences Advances (JPSA) welcomes scholarly contributions within its areas of interest. Authors are expected to follow the journal's submission requirements and ensure that all necessary information and supporting documents are prepared before submitting a manuscript."}],["$","div",null,{"className":"notice","children":[["$","strong",null,{"children":"Important submission information"}],["$","p",null,{"children":"The online submission and manuscript tracking system is currently under development. The instructions on this page describe the intended submission procedure and should not be treated as confirmation that the submission portal is operational."}]]}],["$","section",null,{"className":"prose","children":[["$","h2",null,{"children":"1. Before submitting"}],["$","p",null,{"children":"Authors should first confirm that their manuscript falls within the aims and scope of JPSA. The work should be scientifically relevant to physics and its allied disciplines, including theoretical, experimental, computational and interdisciplinary research."}],["$","p",null,{"children":"Before submission, authors should review the journal's Author Guidelines and Manuscript Preparation instructions to ensure that the manuscript is appropriately organised and complete."}],["$","h2",null,{"children":"2. Originality and exclusive submission"}],["$","p",null,{"children":"A manuscript submitted to JPSA should represent original scholarly work and should not be under consideration for publication by another journal at the same time."}],["$","p",null,{"children":"Authors must disclose substantial overlap with previously published work, related manuscripts and preprints. All sources and reused material should be appropriately acknowledged."}],["$","h2",null,{"children":"3. Author approval"}],["$","p",null,{"children":"All listed authors should have made an appropriate contribution to the research, reviewed the final manuscript and approved its submission to the journal."}],["$","p",null,{"children":"The corresponding author is responsible for coordinating communication with the editorial office and confirming that all co-authors agree with the submitted version and author list."}],["$","h2",null,{"children":"4. Files required for submission"}],["$","p",null,{"children":"Authors should prepare the following materials, as applicable to the manuscript and the requirements of the submission system:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Main manuscript:"}]," The complete manuscript, including its title, abstract, keywords, main text and references."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Figures and tables:"}]," Relevant illustrations, tables and captions in suitable formats and resolution."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Author information:"}]," Full names, institutional affiliations and contact details of all contributors."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Declarations:"}]," Statements concerning authorship, competing interests, funding, data availability and research ethics, where applicable."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Supplementary material:"}]," Supporting datasets, computational files, additional figures or other relevant research materials."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Permissions:"}]," Evidence of permission to reproduce copyrighted figures, tables or other third-party material, where required."]}]]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}]]}],null,"$L32"]}]
