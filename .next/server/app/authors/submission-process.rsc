16:["$","h2",null,{"children":"5. Submission of manuscript details"}]
17:["$","p",null,{"children":"When the submission system becomes available, authors will be expected to provide the relevant manuscript information. This may include the manuscript title, abstract, keywords, article category, author details and institutional affiliations."}]
18:["$","p",null,{"children":"The corresponding author should ensure that the information entered into the submission system matches the details in the manuscript."}]
19:["$","h2",null,{"children":"6. Required declarations"}]
1a:["$","p",null,{"children":"Authors should be prepared to provide declarations relevant to the integrity and transparency of their research. These may include:"}]
1b:["$","ul",null,{"children":[["$","li",null,{"children":"Confirmation of originality and exclusive submission."}],["$","li",null,{"children":"Approval of the manuscript by all listed authors."}],["$","li",null,{"children":"Disclosure of financial and non-financial competing interests."}],["$","li",null,{"children":"Funding and financial support information."}],["$","li",null,{"children":"Author contribution statements."}],["$","li",null,{"children":"Data availability statements, where relevant."}],["$","li",null,{"children":"Research ethics approval and consent information, where applicable."}]]}]
1c:["$","h2",null,{"children":"7. Initial editorial checks"}]
1d:["$","p",null,{"children":"After a manuscript is submitted, the editorial office may conduct an initial completeness check. This may include verification of the required files, author information, declarations and basic presentation requirements."}]
1e:["$","p",null,{"children":"If information is missing or corrections are necessary, the corresponding author may be contacted to provide the required material."}]
1f:["$","h2",null,{"children":"8. Editorial assessment and peer review"}]
20:["$","p",null,{"children":"Submissions that satisfy the initial requirements may proceed to editorial assessment. The editor evaluates the manuscript's relevance, originality and suitability for further consideration."}]
21:["$","p",null,{"children":"Manuscripts considered suitable may be sent for external peer review. The resulting editorial decision may involve acceptance, revision or rejection, depending on the assessment."}]
22:["$","p",null,{"children":"Submission does not guarantee acceptance or publication."}]
23:["$","h2",null,{"children":"9. Revised manuscripts"}]
24:["$","p",null,{"children":"Where revision is requested, authors should carefully address the comments provided by reviewers and editors. A revised manuscript should be accompanied by a point-by-point response explaining the changes made."}]
25:["$","p",null,{"children":"If additional time is required to prepare a revision, the corresponding author should communicate with the editorial office before the specified deadline."}]
26:["$","h2",null,{"children":"10. Correspondence and manuscript tracking"}]
27:["$","p",null,{"children":"The corresponding author should monitor communications from the editorial office and provide any requested clarifications or additional information within the indicated timeframe."}]
28:["$","p",null,{"children":"Once the online manuscript tracking facility is operational, authors may be provided with access to submission status information through the designated system."}]
29:["$","h2",null,{"children":"11. Publication after acceptance"}]
2a:["$","p",null,{"children":"Manuscripts accepted for publication may proceed to editorial preparation, proofreading and production. Authors may be asked to review proofs and verify the accuracy of the final publication details."}]
2b:["$","p",null,{"children":"Any applicable publication charges and payment arrangements should be communicated transparently under the journal's approved APC policy."}]
2c:["$","h2",null,{"children":"12. Submission checklist"}]
2d:["$","p",null,{"children":"Before submitting a manuscript, authors should confirm that:"}]
2e:["$","ul",null,{"children":[["$","li",null,{"children":"The manuscript falls within the scope of JPSA."}],["$","li",null,{"children":"The manuscript is original and not under consideration elsewhere."}],["$","li",null,{"children":"All authors have approved the final version."}],["$","li",null,{"children":"Author names and affiliations are accurate."}],["$","li",null,{"children":"Figures, tables and references are complete."}],["$","li",null,{"children":"Required declarations have been prepared."}],["$","li",null,{"children":"Necessary permissions have been obtained."}],["$","li",null,{"children":"Supplementary files are ready, where applicable."}]]}]
2f:["$","h2",null,{"children":"Related information"}]
30:["$","p",null,{"children":"Authors should review the following resources before preparing a submission:"}]
31:["$","ul",null,{"children":[["$","li",null,{"children":["$","$L2",null,{"href":"/authors/guidelines","children":"Author Guidelines"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/authors/manuscript-preparation","children":"Manuscript Preparation"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/authors/peer-review","children":"Peer Review Process"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/policies/authorship-policy","children":"Authorship Policy"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/policies/plagiarism-policy","children":"Plagiarism Policy"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/policies/publication-ethics","children":"Publication Ethics"}]}]]}]
