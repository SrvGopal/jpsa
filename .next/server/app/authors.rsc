11:["$","$1","c",{"children":[["$","main",null,{"className":"container page","children":[["$","div",null,{"className":"eyebrow","children":"INFORMATION FOR CONTRIBUTORS"}],["$","h1",null,{"children":"For Authors"}],["$","p",null,{"className":"lead","children":"JPSA welcomes scholarly contributions in physics and interdisciplinary physical sciences. Authors should review the journal's requirements before preparing a manuscript."}],["$","section",null,{"className":"prose","children":[["$","h2",null,{"children":"Before submitting"}],["$","p",null,{"children":"Authors should ensure that their manuscript is original, relevant to the journal's scope and prepared in accordance with the applicable author instructions."}],["$","ul",null,{"children":[["$","li",null,{"children":"Confirm that the manuscript fits the journal's scope."}],["$","li",null,{"children":"Ensure that all listed authors have approved the manuscript."}],["$","li",null,{"children":"Prepare accurate author affiliations and contact details."}],["$","li",null,{"children":"Include relevant funding and conflict-of-interest declarations."}],["$","li",null,{"children":"Ensure that figures, tables and references are properly documented."}]]}]]}],["$","section",null,{"className":"section","children":[["$","div",null,{"className":"eyebrow","children":"AUTHOR RESOURCES"}],["$","h2",null,{"children":"Submission resources"}],["$","div",null,{"className":"link-grid","children":[["$","$L2","01",{"href":"/authors/guidelines","className":"resource-card","children":[["$","span",null,{"className":"eyebrow","children":"01"}],["$","h3",null,{"children":"Author Guidelines"}],["$","p",null,{"children":"Understand the journal's manuscript requirements, declarations and publication process."}],["$","span",null,{"className":"resource-action","children":["Read guidelines"," →"]}]]}],["$","$L2","02",{"href":"/authors/manuscript-preparation","className":"resource-card","children":[["$","span",null,{"className":"eyebrow","children":"02