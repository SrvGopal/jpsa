16:["$","p",null,{"children":"Research submitted to JPSA should be conducted and reported honestly. Authors are expected to preserve the accuracy of their research records and present methods, observations, results, and interpretations without deliberate distortion."}]
17:["$","p",null,{"children":"Where research involves human participants, animals, personal information, or other activities requiring formal ethical oversight, authors should obtain the relevant approvals before conducting the research and report applicable approval information in the manuscript."}]
18:["$","p",null,{"children":"Authors should also ensure that appropriate consent, confidentiality, and safeguards have been observed wherever the nature of the research requires them. The journal may request supporting information concerning ethical approval or consent when relevant."}]
19:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"4. Research Misconduct"}],["$","p",null,{"children":"JPSA does not accept research practices that compromise the reliability of scientific findings or misrepresent the contributions of researchers. Potential forms of misconduct include:"}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Fabrication of Research Data",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CONCERN ","01"]}],["$","h3",null,{"children":"Fabrication of Research Data"}],["$","p",null,{"children":"Inventing experimental observations, measurements, results, or other research information and presenting them as genuine findings."}]]}],["$","article","Falsification and Manipulation",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CONCERN ","02"]}],["$","h3",null,{"children":"Falsification and Manipulation"}],["$","p",null,{"children":"Manipulating research materials, equipment, procedures, images, data, or results in a way that misrepresents the actual research or its findings."}]]}],["$","article","Plagiarism",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CONCERN ","03"]}],["$","h3",null,{"children":"Plagiarism"}],["$","p",null,{"children":"Using another person's language, ideas, research, data, or intellectual contribution without appropriate acknowledgement. Such cases are addressed under the journal's Plagiarism Policy."}]]}],["$","article","Improper Authorship",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CONCERN ","04"]}],["$","h3",null,{"children":"Improper Authorship"}],["$","p",null,{"children":"Misrepresenting who contributed to a manuscript, including honorary authorship, ghost authorship, omission of eligible contributors, or inaccurate contribution statements."}]]}],["$","article","Duplicate or Redundant Submission",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CONCERN ","05"]}],["$","h3",null,{"children":"Duplicate or Redundant Submission"}],["$","p",null,{"children":"Submitting substantially the same manuscript to multiple journals simultaneously or presenting previously published work as a new and independent contribution without appropriate disclosure."}]]}],["$","article","Manipulation of the Editorial Process",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CONCERN ","06"]}],["$","h3",null,{"children":"Manipulation of the Editorial Process"}],["$","p",null,{"children":"Attempting to influence editorial decisions through fabricated reviewer identities, undisclosed relationships, coercion, inappropriate communication, or other improper means."}]]}]]}],["$","p",null,{"children":"The presence of an allegation does not automatically establish misconduct. Concerns should be examined on the basis of relevant evidence and the circumstances of the particular case."}]]}]
1a:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"5. Peer Review Integrity"}],["$","p",null,{"children":"Peer review is an important part of the scholarly assessment of submitted manuscripts. Reviewers should assess the scientific content independently and provide comments that are relevant, reasoned, and constructive."}],["$","p",null,{"children":"Reviewers must not use unpublished information obtained through the review process for personal research, professional advantage, or any other unauthorised purpose. Manuscripts and associated information must be treated as confidential."}],["$","p",null,{"children":"Editors should ensure that reviewer selection and editorial decisions are not improperly influenced by personal relationships, competing interests, or external pressure. Suspected manipulation of peer review should be examined as a publication-ethics concern."}],["$","p",null,{"children":"The journal's detailed review arrangements, including the applicable review model and submission procedure, are described in its separate peer-review policy."}]]}]
1b:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"6. Confidentiality"}],["$","p",null,{"children":"Information contained in submitted manuscripts, reviewer reports, editorial correspondence, and associated records should be handled with appropriate confidentiality."}],["$","p",null,{"children":"Editors and reviewers must not disclose unpublished manuscript content to unauthorised individuals. Information obtained through editorial duties must not be used for personal benefit or to disadvantage authors."}],["$","p",null,{"children":"Confidentiality may be subject to appropriate exceptions where disclosure is necessary to investigate a serious ethical concern or comply with a legitimate institutional or legal requirement."}]]}]
1c:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"7. Conflicts of Interest"}],["$","p",null,{"children":"Authors, reviewers, and editors must disclose relationships or interests that could influence, or reasonably be perceived to influence, their professional judgement."}],["$","p",null,{"children":"Relevant interests may be financial, professional, institutional, personal, or academic. A disclosed conflict does not necessarily prevent participation in the publication process; it should be assessed and managed appropriately."}],["$","p",null,{"children":["Further requirements are provided in the journal's"," ",["$","$L2",null,{"href":"/policies/conflict-of-interest","children":"Conflict of Interest Policy"}],"."]}]]}]
1d:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"8. Corrections, Expressions of Concern, and Retractions"}],["$","p",null,{"children":"The integrity of the published scholarly record must be maintained even after an article has appeared in the journal. Where significant errors or ethical concerns are identified, the editorial team may assess whether a formal post-publication notice is required."}],["$","p",null,{"children":"A correction may be appropriate where an error can be addressed without invalidating the central findings or conclusions of an article. An expression of concern may be considered when a serious issue requires further examination but the available information is not yet sufficient for a final conclusion."}],["$","p",null,{"children":"Retraction may be considered where the reliability of an article is seriously compromised, including cases involving established plagiarism, fabricated or falsified results, or other substantial publication-ethics violations."}],["$","p",null,{"children":"Editorial notices should clearly identify the affected publication and explain the reason for the action to the extent appropriate."}]]}]
1e:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"9. Handling Ethical Allegations"}],["$","p",null,{"children":"Concerns about possible ethical misconduct may be brought to the attention of the editorial office by authors, reviewers, readers, researchers, or other relevant parties. Reports should include sufficient information to allow the concern to be examined."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Initial Assessment",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Initial Assessment"}],["$","p",null,{"children":"When a potential ethical concern is identified, the editorial team may examine the available information and request clarification or supporting documentation from the relevant authors or other parties."}]]}],["$","article","Further Examination",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Further Examination"}],["$","p",null,{"children":"Where necessary, the journal may seek additional evidence, consult relevant editorial expertise, or contact an author's affiliated institution or another appropriate authority. The nature of the concern will determine the appropriate course of examination."}]]}],["$","article","Editorial Decision",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Editorial Decision"}],["$","p",null,{"children":"Following consideration of the available evidence and explanations, the journal may decide to proceed with the manuscript, request clarification or revision, suspend processing, reject the submission, or take another appropriate action."}]]}],["$","article","Post-Publication Action",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Post-Publication Action"}],["$","p",null,{"children":"Where a concern relates to an already published article, the journal may consider a correction, an expression of concern, or retraction, depending on the seriousness of the issue and its effect on the scholarly record."}]]}]]}],["$","p",null,{"children":"The journal may request explanations from the individuals concerned and, where appropriate, consult relevant institutions or authorities. Any editorial action should be proportionate to the available evidence and the seriousness of the issue."}]]}]
1f:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"10. Editorial Independence"}],["$","p",null,{"children":"Editorial decisions should be based on scholarly merit, relevance to the journal's scope, and applicable publication requirements. Commercial, personal, institutional, or other external considerations should not improperly determine whether a manuscript is accepted or rejected."}],["$","p",null,{"children":"Individuals involved in editorial decisions must disclose relevant competing interests and should not participate in decisions where their impartiality may reasonably be questioned."}]]}]
20:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"11. Related Policies"}],["$","p",null,{"children":"The following policies provide additional requirements concerning specific areas of publication ethics:"}],["$","ul",null,{"children":[["$","li",null,{"children":["$","$L2",null,{"href":"/policies/plagiarism-policy","children":"Plagiarism Policy"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/policies/authorship-policy","children":"Authorship Policy"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/policies/conflict-of-interest","children":"Conflict of Interest Policy"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/policies/copyright","children":"Copyright Policy"}]}]]}]]}]
