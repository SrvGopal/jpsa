13:["$","$1","c",{"children":[["$","div",null,{"className":"container page journal-content-page","children":[["$","div",null,{"className":"eyebrow","children":"PUBLICATION POLICIES"}],["$","h1",null,{"children":"Publication Ethics"}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"1. Ethical Framework"}],["$","p",null,{"children":"Journal of Physical Science Advances (JPSA) recognises that responsible scholarly publishing depends on honesty, transparency, accountability, and respect for the scientific record. Every stage of publication, from manuscript preparation and submission to peer review, editorial decision-making, and post-publication correction, should be conducted with these principles in mind."}],["$","p",null,{"children":"The journal expects authors, editors, reviewers, and all individuals involved in the publication process to act professionally and uphold accepted standards of research integrity. Ethical requirements apply to all submissions, irrespective of the subject area, institution, or professional standing of the individuals involved."}],["$","p",null,{"children":"This policy describes the journal's general expectations concerning ethical conduct. It should be read together with the individual policies governing plagiarism, authorship, conflicts of interest, and copyright."}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"2. Responsibilities of Participants"}],["$","p",null,{"children":"Maintaining publication ethics is a shared responsibility. Each participant in the publication process has a distinct role in protecting the integrity and reliability of scholarly communication."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Authors",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Authors"}],["$","p",null,{"children":"Authors are responsible for the accuracy, originality, and integrity of their submitted work. They must provide an honest account of the research undertaken, acknowledge relevant sources, report findings accurately, disclose competing interests, and ensure that all listed authors have approved the manuscript."}]]}],["$","article","Editors",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Editors"}],["$","p",null,{"children":"Editors are responsible for evaluating submissions on their scholarly merit, relevance, and suitability for the journal. Editorial decisions must be based on the quality and scientific content of a manuscript rather than the authors' identity, institutional affiliation, nationality, personal relationships, or other irrelevant considerations."}]]}],["$","article","Reviewers",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Reviewers"}],["$","p",null,{"children":"Reviewers are expected to provide objective, constructive, and evidence-based assessments. They should identify relevant work that has not been cited, explain concerns about methodology or interpretation, disclose potential conflicts of interest, and maintain the confidentiality of manuscripts under review."}]]}],["$","article","Editorial Office",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Editorial Office"}],["$","p",null,{"children":"The editorial office is responsible for maintaining appropriate submission records, communicating editorial decisions, handling confidential manuscript information, and supporting the consistent application of the journal's publication policies."}]]}]]}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"3. Ethical Responsibilities in Research"}],"$L16","$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}],null,"$L21"]}]
14:["$","$1","h",{"children":[null,[["$","$L22",null,{"children":"$L23"}],null],["$","$L24",null,{"children":["$","div",null,{"hidden":true,"children":["$","$25",null,{"fallback":null,"children":"$L26"}]}]}]]}]
