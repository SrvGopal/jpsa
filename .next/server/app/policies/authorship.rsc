16:["$","p",null,{"children":"Individuals who have made a substantial contribution to the research but have not participated in manuscript preparation, final approval, or accountability should be invited to fulfil the relevant requirements where appropriate. Authorship should not be assigned solely on the basis of a single isolated activity."}]
17:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"3. Unacceptable Authorship Practices"}],["$","p",null,{"children":"JPSA does not accept practices that distort the actual contributions of individuals involved in scientific research. The following practices are considered inappropriate and may constitute breaches of publication ethics."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Gift or Honorary Authorship",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["PRACTICE ","01"]}],["$","h3",null,{"children":"Gift or Honorary Authorship"}],["$","p",null,{"children":"Including an individual as an author solely because of their academic position, seniority, institutional authority, financial support, or personal relationship with the research team, without a qualifying intellectual contribution."}]]}],["$","article","Guest Authorship",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["PRACTICE ","02"]}],["$","h3",null,{"children":"Guest Authorship"}],["$","p",null,{"children":"Adding a person's name to a manuscript to increase its perceived credibility, influence, or likelihood of acceptance when that individual has not made a qualifying contribution."}]]}],["$","article","Ghost Authorship",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["PRACTICE ","03"]}],["$","h3",null,{"children":"Ghost Authorship"}],["$","p",null,{"children":"Excluding an individual who has made a substantial contribution to the research or manuscript, particularly where that person's involvement is deliberately concealed or their contribution is not appropriately acknowledged."}]]}],["$","article","Omission of Eligible Contributors",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["PRACTICE ","04"]}],["$","h3",null,{"children":"Omission of Eligible Contributors"}],["$","p",null,{"children":"Failing to include a researcher who satisfies the journal's authorship criteria, without a legitimate reason or the individual's agreement."}]]}],["$","article","Misrepresentation of Contributions",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["PRACTICE ","05"]}],["$","h3",null,{"children":"Misrepresentation of Contributions"}],["$","p",null,{"children":"Providing inaccurate or misleading information about the role, responsibility, or contribution of an individual listed as an author."}]]}]]}],["$","p",null,{"children":"Any indication that authorship has been manipulated, misrepresented, or deliberately concealed may be examined by the editorial team. Depending on the circumstances, the journal may request an explanation, suspend editorial processing, or take further action."}]]}]
18:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"4. Contributions That Do Not Independently Qualify for Authorship"}],["$","p",null,{"children":"Certain forms of assistance are valuable to scientific research but do not independently establish eligibility for authorship. Such contributions should normally be recognised in the acknowledgements section, with the individual's consent."}],["$","ul",null,{"children":[["$","li","Providing general supervision or administrative assistance without a qualifying intellectual contribution.",{"children":"Providing general supervision or administrative assistance without a qualifying intellectual contribution."}],["$","li","Obtaining funding or institutional resources without participating substantially in the research.",{"children":"Obtaining funding or institutional resources without participating substantially in the research."}],["$","li","Providing routine technical assistance, equipment access, or laboratory facilities.",{"children":"Providing routine technical assistance, equipment access, or laboratory facilities."}],["$","li","Performing isolated data collection or routine testing without meaningful involvement in the research design, analysis, or interpretation.",{"children":"Performing isolated data collection or routine testing without meaningful involvement in the research design, analysis, or interpretation."}],["$","li","Providing proofreading, language editing, formatting, or reference-management assistance alone.",{"children":"Providing proofreading, language editing, formatting, or reference-management assistance alone."}]]}],["$","p",null,{"children":"The distinction between authorship and acknowledgement depends on the actual nature and extent of an individual's contribution. For example, technical assistance may form part of a qualifying authorship contribution when accompanied by substantial intellectual involvement and fulfilment of the other authorship criteria."}]]}]
19:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"5. Author Order and Contribution"}],["$","p",null,{"children":"The order of authors should be determined collectively by the research team before manuscript submission. Authors are responsible for discussing and agreeing upon the order based on the relative nature and extent of their contributions to the research and manuscript."}],["$","p",null,{"children":"JPSA does not automatically prescribe a universal interpretation of first, middle, or last authorship positions, since conventions may differ across scientific disciplines and research groups. The author order should reflect an agreement among the contributors and should not be used to misrepresent individual involvement."}],["$","p",null,{"children":"Where a manuscript includes equal contributions, the authors may provide an appropriate equal-contribution statement. Similarly, a corresponding author or senior author designation should accurately reflect the agreed responsibilities and actual role of the individual."}]]}]
1a:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"6. Corresponding Author Responsibilities"}],["$","p",null,{"children":"The corresponding author acts as the principal point of communication between the authors and the journal throughout the submission and publication process. The corresponding author is responsible for coordinating communication and ensuring that the submission accurately represents the collective agreement of the author group."}],["$","p",null,{"children":"The corresponding author is expected to:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Obtain the agreement of all authors before submitting the manuscript."}],["$","li",null,{"children":"Confirm that every listed author has reviewed and approved the submitted version."}],["$","li",null,{"children":"Provide complete and accurate author names, affiliations, and contact details."}],["$","li",null,{"children":"Communicate editorial decisions, reviewer comments, and requests for revision to the co-authors."}],["$","li",null,{"children":"Coordinate the preparation and submission of revised manuscripts."}],["$","li",null,{"children":"Disclose any relevant authorship changes and obtain the required written agreement."}],["$","li",null,{"children":"Ensure that all authors are informed of the final publication decision and publication-stage corrections."}]]}],["$","p",null,{"children":"Designation as corresponding author does not remove the responsibility of other authors for their respective contributions or for the integrity of the research."}]]}]
1b:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"7. Author Contributions Statement"}],["$","p",null,{"children":"JPSA may request a statement describing the individual contributions of each author. This statement is intended to make the responsibilities of the research team transparent and to provide a clear record of how the work was conducted."}],["$","p",null,{"children":"Where applicable, contributions may be described using recognised contributor roles, including:"}],["$","ul",null,{"children":[["$","li","Conceptualization",{"children":"Conceptualization"}],["$","li","Methodology",{"children":"Methodology"}],["$","li","Investigation",{"children":"Investigation"}],["$","li","Formal analysis",{"children":"Formal analysis"}],["$","li","Software",{"children":"Software"}],["$","li","Validation",{"children":"Validation"}],["$","li","Data curation",{"children":"Data curation"}],["$","li","Visualization",{"children":"Visualization"}],["$","li","Writing – original draft",{"children":"Writing – original draft"}],["$","li","Writing – review and editing",{"children":"Writing – review and editing"}],["$","li","Resources",{"children":"Resources"}],["$","li","Supervision",{"children":"Supervision"}],["$","li","Project administration",{"children":"Project administration"}],["$","li","Funding acquisition",{"children":"Funding acquisition"}]]}],["$","p",null,{"children":"A contribution statement should identify the roles performed by each author accurately. Not every role needs to be assigned to every author, and listing a contributor role does not independently establish eligibility for authorship."}]]}]
1c:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"8. Acknowledgements"}],["$","p",null,{"children":"Individuals and organisations that have provided meaningful assistance but do not meet the authorship criteria may be recognised in the acknowledgements section. Such recognition may include technical assistance, laboratory support, access to facilities, language editing, administrative assistance, or other relevant contributions."}],["$","p",null,{"children":"Authors should obtain permission from individuals before including their names in the acknowledgements. Financial support, institutional assistance, and relevant research facilities should be acknowledged accurately and transparently."}],["$","p",null,{"children":"Acknowledgement must not be used as a substitute for authorship where an individual has made a qualifying intellectual contribution and satisfies the journal's authorship requirements."}]]}]
1d:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"9. Changes to Authorship"}],["$","p",null,{"children":"The author list should be finalised before submission. Any subsequent change must be supported by a legitimate explanation and the agreement of all individuals affected by the change."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Addition of an Author",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Addition of an Author"}],["$","p",null,{"children":"A request to add an author after initial submission must include a written explanation of the person's contribution and confirmation that the proposed author satisfies the journal's authorship criteria. Agreement from all existing authors and the proposed author must be obtained."}]]}],["$","article","Removal of an Author",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Removal of an Author"}],["$","p",null,{"children":"A request to remove an author must include an explanation and written confirmation from all authors concerned. The journal may seek clarification where the removal raises questions about contribution, consent, or the integrity of the author list."}]]}],["$","article","Change in Author Order",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Change in Author Order"}],["$","p",null,{"children":"Changes to author order after submission must be justified and agreed upon by all authors. The editorial office may request written confirmation before considering the proposed change."}]]}],["$","article","Changes After Acceptance",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Changes After Acceptance"}],["$","p",null,{"children":"Changes to authorship after manuscript acceptance require particular scrutiny. The journal may suspend the production process while the request is examined. Changes after publication may require a formal correction to the published record."}]]}]]}],["$","p",null,{"children":"JPSA reserves the right to delay further processing until the authorship request has been adequately explained and documented. The journal may decline a proposed change where the necessary agreement or supporting information is not provided."}]]}]
1e:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"10. Use of Artificial Intelligence Tools"}],["$","p",null,{"children":"Artificial intelligence tools and other automated systems may assist researchers with activities such as language improvement, formatting, coding support, literature organisation, and data analysis. However, such tools cannot be listed as authors of a manuscript."}],["$","p",null,{"children":"Authorship requires the ability to take responsibility for research contributions, approve the final manuscript, and respond to questions concerning the integrity of the work. AI systems cannot independently fulfil these responsibilities."}],["$","p",null,{"children":"Authors remain fully responsible for the accuracy, originality, references, interpretations, and integrity of material included in their manuscripts, including content generated or assisted by AI tools."}],["$","p",null,{"children":"Where AI tools have been used in a manner that materially contributes to the research or manuscript, authors should disclose their use in accordance with the journal's applicable submission requirements. AI-generated or AI-assisted material must not be used to fabricate research findings, references, data, images, or other scholarly evidence."}]]}]
1f:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"11. Authorship Disputes"}],["$","p",null,{"children":"Disagreements concerning author eligibility, author order, omitted contributors, or changes to the author list should initially be addressed by the authors and their research team."}],["$","p",null,{"children":"Where an authorship dispute is brought to the attention of JPSA, the editorial office may request written explanations, contribution statements, and confirmation from the individuals involved. The journal may suspend the processing or publication of the manuscript while the matter remains unresolved."}],["$","p",null,{"children":"The journal is not expected to determine employment, institutional, contractual, or other personal disputes between researchers. Where necessary, the matter may be referred to the relevant institution or appropriate research authority for investigation."}],["$","p",null,{"children":"Editorial processing may resume when sufficient clarification or an appropriate resolution has been provided."}]]}]
20:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"12. Post-Publication Authorship Concerns"}],["$","p",null,{"children":"If an authorship concern is identified after an article has been published, the journal may examine the available evidence and seek explanations from the authors or relevant institutions."}],["$","p",null,{"children":"Depending on the findings, appropriate action may include a correction to the author list, an authorship clarification, an expression of concern, or another corrective notice where necessary. Any amendment to the published record should be documented through an appropriate editorial notice."}]]}]
21:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"13. Editorial Responsibility"}],["$","p",null,{"children":"The editorial team is responsible for considering authorship-related concerns in a fair, consistent, and evidence-based manner. The journal may request additional documentation when the author list or reported contributions require clarification."}],["$","p",null,{"children":"JPSA expects all authors to act honestly when identifying contributors and describing their respective roles. The purpose of this policy is to ensure that academic credit is assigned appropriately and that every published article has a transparent record of responsibility."}]]}]
22:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Related Policies"}],["$","p",null,{"children":["Authors should also consult the journal's"," ",["$","$L2",null,{"href":"/policies/plagiarism-policy","children":"Plagiarism Policy"}]," ","and other applicable publication ethics and submission requirements before submitting a manuscript."]}]]}]
