13:["$","$1","c",{"children":[["$","div",null,{"className":"container page journal-content-page","children":[["$","div",null,{"className":"eyebrow","children":"PUBLICATION ETHICS"}],["$","h1",null,{"children":"Authorship Policy"}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"1. Policy Statement"}],["$","p",null,{"children":"Journal of Physical Science Advances (JPSA) considers authorship an important recognition of intellectual contribution and responsibility in scientific publication. The designation of an individual as an author indicates that the person has made a meaningful contribution to the research and accepts responsibility for the integrity of their contribution."}],["$","p",null,{"children":"Authorship must be based on genuine academic and scientific involvement. An individual's position, designation, institutional affiliation, financial contribution, or professional relationship with the research team does not, by itself, establish eligibility for authorship."}],["$","p",null,{"children":"All individuals listed as authors must satisfy the journal's authorship requirements. The author list must accurately reflect the people who contributed to the work, and individuals who do not qualify as authors should be acknowledged appropriately where their contributions are relevant."}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"2. Criteria for Authorship"}],["$","p",null,{"children":"JPSA expects every listed author to satisfy all four of the following criteria. These requirements are intended to ensure that authorship reflects both meaningful involvement in the research and responsibility for the resulting publication."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Substantial Intellectual Contribution",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CRITERION ","01"]}],["$","h3",null,{"children":"Substantial Intellectual Contribution"}],["$","p",null,{"children":"The individual must have made a significant contribution to the conception or design of the research, or to the acquisition, analysis, or interpretation of the data. Contributions should involve meaningful intellectual or scientific involvement rather than routine assistance alone."}]]}],["$","article","Participation in Manuscript Preparation",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CRITERION ","02"]}],["$","h3",null,{"children":"Participation in Manuscript Preparation"}],["$","p",null,{"children":"The individual must have participated in drafting the manuscript or critically revising it for important intellectual content. Merely reviewing the manuscript for grammar, formatting, or language corrections does not independently establish authorship."}]]}],["$","article","Approval of the Final Manuscript",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CRITERION ","03"]}],["$","h3",null,{"children":"Approval of the Final Manuscript"}],["$","p",null,{"children":"Every author must review and approve the final version of the manuscript before submission or publication. Authors should be satisfied that the work accurately represents the research and the contributions made by the authors."}]]}],["$","article","Accountability for the Research",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CRITERION ","04"]}],["$","h3",null,{"children":"Accountability for the Research"}],["$","p",null,{"children":"Each author must agree to take responsibility for their own contributions and cooperate in addressing questions concerning the accuracy, integrity, or reliability of any part of the work. Authors should understand the overall research sufficiently to identify which co-authors are responsible for other specific contributions."}]]}]]}],"$L16"]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],null,"$L23"]}]
