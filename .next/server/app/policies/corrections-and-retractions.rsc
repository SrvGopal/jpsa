11:["$","p",null,{"children":"Corrections are generally appropriate when the affected information can be amended without undermining the central scientific findings or conclusions of the research."}]
12:["$","p",null,{"children":"Examples of matters that may require correction include:"}]
13:["$","div",null,{"className":"subject-area-grid","children":[["$","article","Errors in Author Information",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Errors in Author Information"}],["$","p",null,{"children":"Incorrect author names, affiliations, institutional details, or other publication information may require correction where the error affects the accuracy of the published record."}]]}],["$","article","Errors in Figures and Tables",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Errors in Figures and Tables"}],["$","p",null,{"children":"Incorrect figure labels, table entries, captions, or other graphical or tabular information may be corrected where the underlying research remains reliable."}]]}],["$","article","Errors in References and Citations",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Errors in References and Citations"}],["$","p",null,{"children":"Incorrect bibliographic information, missing citations, or inaccurate references may be amended where the correction improves the accuracy and traceability of the article."}]]}],["$","article","Errors in Scientific Content",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Errors in Scientific Content"}],["$","p",null,{"children":"An error in a calculation, equation, description, or interpretation may warrant correction when its effect on the article's conclusions is limited and can be clearly addressed."}]]}],["$","article","Errors in Publication Information",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Errors in Publication Information"}],["$","p",null,{"children":"Errors introduced during manuscript preparation, editing, typesetting, or publication may be corrected to maintain the accuracy and clarity of the final published version."}]]}]]}]
14:["$","p",null,{"children":"A correction notice should identify the article, describe the error, provide the corrected information, and explain the amendment where necessary. The correction should be linked to the original article so that readers can identify the relationship between the two records."}]
15:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"4. Expressions of Concern"}],["$","p",null,{"children":"An expression of concern may be issued when credible information raises questions about the reliability or integrity of a published article, but the available evidence does not yet justify a final editorial conclusion."}],["$","p",null,{"children":"This may occur when an investigation is incomplete, when relevant documentation is unavailable, or when the journal is awaiting clarification from authors or their affiliated institutions."}],["$","p",null,{"children":"An expression of concern is intended to provide transparency to readers while the matter is examined. It does not, by itself, establish that misconduct has occurred."}],["$","p",null,{"children":"Following further examination, the journal may decide to issue a correction, retract the article, replace the expression of concern with another appropriate notice, or take no further action."}]]}]
16:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"5. Grounds for Retraction"}],["$","p",null,{"children":"Retraction may be considered when the reliability, originality, or ethical integrity of a published article is substantially compromised. The purpose of retraction is to alert readers that the article should no longer be treated as a reliable contribution to the scientific literature."}],["$","p",null,{"children":"Potential grounds for retraction include:"}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Fabrication or Falsification of Data",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["GROUND ","01"]}],["$","h3",null,{"children":"Fabrication or Falsification of Data"}],["$","p",null,{"children":"Evidence that research observations, measurements, images, or results have been invented, manipulated, or deliberately misrepresented."}]]}],["$","article","Substantial Plagiarism",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["GROUND ","02"]}],["$","h3",null,{"children":"Substantial Plagiarism"}],["$","p",null,{"children":"Established plagiarism involving another researcher's intellectual contribution, research findings, or substantial portions of published work."}]]}],["$","article","Unreliable Research Findings",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["GROUND ","03"]}],["$","h3",null,{"children":"Unreliable Research Findings"}],["$","p",null,{"children":"Serious errors in research design, methodology, analysis, or interpretation that invalidate the central findings or conclusions of the article."}]]}],["$","article","Unethical Research Practices",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["GROUND ","04"]}],["$","h3",null,{"children":"Unethical Research Practices"}],["$","p",null,{"children":"Research conducted or reported in violation of essential ethical requirements, including serious issues involving consent, research approval, or the treatment of research participants where applicable."}]]}],["$","article","Duplicate or Redundant Publication",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["GROUND ","05"]}],["$","h3",null,{"children":"Duplicate or Redundant Publication"}],["$","p",null,{"children":"Publication of substantially overlapping material without appropriate disclosure where the duplication materially compromises the integrity of the scholarly record."}]]}],["$","article","Compromised Publication Process",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["GROUND ","06"]}],["$","h3",null,{"children":"Compromised Publication Process"}],["$","p",null,{"children":"Evidence of manipulated peer review, fraudulent authorship, fabricated reviewer identities, or other serious interference with the editorial and publication process."}]]}]]}],["$","p",null,{"children":"Retraction is not intended as a punishment for honest mistakes that can be adequately corrected. The decision should be based on the seriousness of the issue and its effect on the validity or integrity of the published work."}]]}]
17:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"6. Procedure for Investigating Concerns"}],["$","p",null,{"children":"JPSA aims to examine post-publication concerns through a fair, documented, and evidence-based editorial process. The following stages describe the general procedure:"}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Receipt of Concern",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["STAGE ","01"]}],["$","h3",null,{"children":"Receipt of Concern"}],["$","p",null,{"children":"A concern may be raised by an author, reader, reviewer, researcher, institution, or another relevant party. The report should identify the affected article and provide sufficient information or supporting evidence for examination."}]]}],["$","article","Preliminary Editorial Assessment",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["STAGE ","02"]}],["$","h3",null,{"children":"Preliminary Editorial Assessment"}],["$","p",null,{"children":"The editorial team examines the reported issue, identifies the nature of the alleged error or misconduct, and determines whether additional information or investigation is necessary."}]]}],["$","article","Request for Explanation",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["STAGE ","03"]}],["$","h3",null,{"children":"Request for Explanation"}],["$","p",null,{"children":"Where appropriate, the journal may contact the corresponding author and other relevant individuals to request clarification, supporting records, original data, or an explanation of the concern."}]]}],["$","article","Further Investigation",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["STAGE ","04"]}],["$","h3",null,{"children":"Further Investigation"}],["$","p",null,{"children":"For complex or serious cases, the journal may seek additional evidence, consult appropriate subject experts, or communicate with the authors' affiliated institutions or other relevant authorities."}]]}],["$","article","Editorial Decision",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["STAGE ","05"]}],["$","h3",null,{"children":"Editorial Decision"}],["$","p",null,{"children":"After reviewing the available information and responses, the editorial team determines whether a correction, expression of concern, retraction, or no further action is appropriate."}]]}],["$","article","Publication of Notice",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["STAGE ","06"]}],["$","h3",null,{"children":"Publication of Notice"}],["$","p",null,{"children":"Where corrective action is required, the journal publishes an appropriate notice identifying the affected article and explaining the reason for the action."}]]}]]}],["$","p",null,{"children":"The steps may vary depending on the nature and urgency of the concern. The journal may take interim measures, including temporarily suspending publication-related activity or issuing an expression of concern, where circumstances warrant such action."}]]}]
18:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"7. Responsibilities of Authors"}],["$","p",null,{"children":"Authors are expected to notify the editorial office promptly when they identify a significant error in their published work. This responsibility applies even when the error is discovered after publication and was not identified during the review or production process."}],["$","p",null,{"children":"Authors should:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Inform the editorial office when a significant error is identified."}],["$","li",null,{"children":"Provide a clear explanation of the error and identify the affected sections, figures, tables, or results."}],["$","li",null,{"children":"Supply corrected information and relevant supporting evidence."}],["$","li",null,{"children":"Explain whether the error affects the research findings, interpretation, or conclusions."}],["$","li",null,{"children":"Cooperate with reasonable editorial enquiries and requests for supporting research records."}],["$","li",null,{"children":"Inform relevant co-authors about the concern and any proposed corrective action."}]]}],["$","p",null,{"children":"Prompt and transparent reporting of honest errors is an important part of responsible scientific conduct."}]]}]
19:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"8. Retraction Notices and the Published Record"}],["$","p",null,{"children":"Where an article is retracted, JPSA should publish a separate retraction notice that clearly identifies the affected article and explains the reason for retraction."}],["$","p",null,{"children":"The notice should provide sufficient information for readers to understand why the article has been retracted. Where appropriate, it should identify whether the retraction arose from research errors, misconduct, ethical concerns, or another significant issue."}],["$","p",null,{"children":"A retracted article should remain identifiable in the publication record, with its retracted status clearly displayed. The original scholarly record should not be silently removed or altered in a manner that conceals the retraction."}],["$","p",null,{"children":"The retraction notice should be connected to the original article so that readers accessing either record can identify the relevant editorial action."}]]}]
1a:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"9. Requests for Corrections or Retractions"}],["$","p",null,{"children":"Authors, readers, researchers, reviewers, and other interested individuals may bring potential errors or publication integrity concerns to the attention of the editorial office."}],["$","p",null,{"children":"A request should include the title of the article, its publication details or DOI where available, a description of the concern, and relevant supporting evidence."}],["$","p",null,{"children":"The journal may request additional information before determining whether a formal correction, expression of concern, or retraction is warranted."}]]}]
1b:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"10. Editorial Independence and Fairness"}],["$","p",null,{"children":"Decisions concerning corrections and retractions should be based on the available evidence and the effect of the identified issue on the scholarly record."}],["$","p",null,{"children":"Such decisions should not be influenced by the professional position of the authors, their institutional affiliation, commercial interests, or external pressure."}],["$","p",null,{"children":"Authors should be given a reasonable opportunity to provide an explanation where appropriate. However, failure to obtain a response does not prevent the journal from taking necessary action when sufficient evidence is available."}]]}]
1c:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"11. Editorial Commitment"}],["$","p",null,{"children":"JPSA considers the reliability of the published scientific record an ongoing responsibility. The journal is committed to addressing significant errors and ethical concerns through transparent editorial action."}],["$","p",null,{"children":"Corrections and retractions are intended to preserve the accuracy of scholarly communication, inform readers about material changes, and maintain confidence in the integrity of published research."}]]}]
1d:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Related Policies"}],["$","p",null,{"children":["This policy should be read alongside the journal's"," ",["$","$L2",null,{"href":"/policies/publication-ethics","children":"Publication Ethics Policy"}],","," ",["$","$L2",null,{"href":"/policies/plagiarism-policy","children":"Plagiarism Policy"}],","," ",["$","$L2",null,{"href":"/policies/authorship-policy","children":"Authorship Policy"}],", and"," ",["$","$L2",null,{"href":"/policies/conflict-of-interest","children":"Conflict of Interest Policy"}],"."]}]]}]
