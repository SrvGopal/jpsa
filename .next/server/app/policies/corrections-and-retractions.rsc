e:["$","$1","c",{"children":[["$","div",null,{"className":"container page journal-content-page","children":[["$","div",null,{"className":"eyebrow","children":"PUBLICATION ETHICS"}],["$","h1",null,{"children":"Corrections and Retractions Policy"}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"1. Policy Statement"}],["$","p",null,{"children":"Journal of Physical Science Advances (JPSA) recognises its responsibility to maintain the accuracy, reliability, and integrity of the scholarly record. The journal acknowledges that errors and concerns may occasionally be identified after an article has been accepted or published."}],["$","p",null,{"children":"Publication does not prevent the journal from examining concerns about the accuracy, originality, ethical compliance, or reliability of a published article. Where an error or serious concern is established, appropriate corrective action may be taken to ensure that readers are informed and the published record is maintained responsibly."}],["$","p",null,{"children":"The nature and extent of the issue will determine the appropriate editorial response. JPSA distinguishes between corrections, expressions of concern, and retractions to ensure that the action taken is proportionate to the seriousness of the matter."}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"2. Types of Post-Publication Action"}],["$","p",null,{"children":"Depending on the circumstances, the journal may take one of the following actions:"}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Correction",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Correction"}],["$","p",null,{"children":"A correction is published when an error is identified in an article but the issue does not invalidate the overall research findings or conclusions. Corrections may concern author information, affiliations, figures, tables, references, typographical errors, or specific statements requiring amendment."}],["$","p",null,{"children":"The original article generally remains available, with a clear link to the published correction notice."}]]}],["$","article","Expression of Concern",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Expression of Concern"}],["$","p",null,{"children":"An expression of concern may be issued when a potentially serious problem has been identified but the available evidence is insufficient for an immediate final decision. It may also be appropriate when an investigation is ongoing or requires clarification from an institution or other relevant authority."}],["$","p",null,{"children":"The notice informs readers that the reliability or integrity of an article is under examination."}]]}],["$","article","Retraction",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Retraction"}],["$","p",null,{"children":"Retraction is considered when the findings or integrity of a published article are substantially compromised. This may arise from established plagiarism, fabricated or falsified data, serious methodological or analytical errors, unethical research practices, or other significant publication-ethics violations."}],["$","p",null,{"children":"A retracted article remains identifiable in the scholarly record, but its retracted status must be clearly indicated."}]]}]]}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"3. Corrections to Published Articles"}],["$","p",null,{"children":"A correction may be considered when an error is identified in a published article and an amendment is necessary to maintain the accuracy and clarity of the publication."}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}],null,"$L1e"]}]
f:["$","$1","h",{"children":[null,[["$","$L1f",null,{"children":"$L20"}],null],["$","$L21",null,{"children":["$","div",null,{"hidden":true,"children":["$","$22",null,{"fallback":null,"children":"$L23"}]}]}]]}]
