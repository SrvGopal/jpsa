13:["$","$1","c",{"children":[["$","div",null,{"className":"container page journal-content-page","children":[["$","div",null,{"className":"eyebrow","children":"PUBLICATION POLICIES"}],["$","h1",null,{"children":"Copyright Policy"}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"1. Policy Statement"}],["$","p",null,{"children":"Journal of Physical Science Advances (JPSA) recognises copyright as an important means of protecting the intellectual contributions of authors and other rights holders. The journal expects all submitted and published material to comply with applicable copyright requirements and intellectual property rights."}],["$","p",null,{"children":"Authors are responsible for ensuring that they have the necessary rights to submit and publish their manuscripts, including any figures, tables, photographs, illustrations, datasets, or other material reproduced from external sources."}],["$","p",null,{"children":"The rights associated with an accepted or published article are governed by the applicable publication agreement and licence. Authors should review those terms carefully before completing the publication process."}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"2. Copyright Ownership"}],["$","p",null,{"children":"Copyright ownership must be established through the publication terms agreed between the authors and the journal. Unless a separate written agreement provides otherwise, authors retain ownership of the original work they have created."}],["$","p",null,{"children":"Authors should ensure that all co-authors have the authority to agree to the applicable publication terms. Where work has been created under employment, institutional, funding, or collaborative arrangements, authors should confirm that no third-party rights prevent publication."}],["$","p",null,{"children":"Acceptance of a manuscript does not remove the obligation to respect copyright owned by other individuals, publishers, institutions, or organisations."}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"3. Rights and Responsibilities of Authors"}],["$","p",null,{"children":"Authors should understand the rights they retain and the permissions they grant to JPSA when their work is accepted for publication. Subject to the final publication agreement, author rights may include:"}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Ownership of Original Work",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Ownership of Original Work"}],["$","p",null,{"children":"Authors should retain ownership of their original intellectual contributions unless a separate written agreement establishes otherwise. Submission of a manuscript does not, by itself, establish that copyright has been transferred to the journal."}]]}],["$","article","Reuse of Published Work",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Reuse of Published Work"}],["$","p",null,{"children":"Authors may retain the ability to use their work in future academic activities, including teaching, research presentations, institutional repositories, and scholarly communication, subject to the applicable publication agreement and licence."}]]}],["$","article","Author-Accepted Manuscripts",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Author-Accepted Manuscripts"}],["$","p",null,{"children":"Authors may use accepted versions of their manuscripts in accordance with the journal's applicable self-archiving and repository requirements. The version deposited, any required acknowledgement, and any applicable embargo should follow the publication agreement."}]]}],"$L16"]}],"$L17"]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}],null,"$L20"]}]
