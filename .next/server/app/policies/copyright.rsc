16:["$","article","Acknowledgement of First Publication",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Acknowledgement of First Publication"}],["$","p",null,{"children":"Where an article has been published by JPSA, subsequent authorised distribution or reuse should acknowledge the original publication and provide an appropriate citation to the published article."}]]}]
17:["$","p",null,{"children":"Authors must not grant conflicting rights to another publisher or party in a manner that prevents them from fulfilling the publication agreement with JPSA."}]
18:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"4. Copyright and Third-Party Material"}],["$","p",null,{"children":"Manuscripts may contain material that is not owned by the authors, including figures, photographs, diagrams, maps, tables, extended quotations, and other copyrighted content. Authors are responsible for determining whether such material can be reproduced in the submitted work."}],["$","p",null,{"children":"Where permission is required, it must be obtained from the appropriate rights holder before publication. Giving a citation alone does not necessarily provide permission to reproduce copyrighted material."}],["$","p",null,{"children":"Authors should:"}],["$","ul",null,{"children":[["$","li","Identify the original source and rights holder of the material.",{"children":"Identify the original source and rights holder of the material."}],["$","li","Determine whether the material is protected by copyright or another applicable intellectual property right.",{"children":"Determine whether the material is protected by copyright or another applicable intellectual property right."}],["$","li","Obtain written permission where the proposed use requires permission.",{"children":"Obtain written permission where the proposed use requires permission."}],["$","li","Provide appropriate attribution and reproduce any required copyright or licence notice.",{"children":"Provide appropriate attribution and reproduce any required copyright or licence notice."}],["$","li","Retain documentation of permissions and provide it to the editorial office when requested.",{"children":"Retain documentation of permissions and provide it to the editorial office when requested."}]]}],["$","p",null,{"children":"Authors should not assume that material available on websites, in online databases, or in previously published articles is free to reproduce."}]]}]
19:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"5. Licensing and Permitted Reuse"}],["$","p",null,{"children":"The licence applicable to a published article determines how readers and other users may access, share, reproduce, or adapt that work. Authors and users should consult the licence displayed with the relevant article before reusing its content."}],["$","p",null,{"children":"JPSA should clearly identify the applicable licence for each published article and ensure that the licence terms are consistent with the publication agreement accepted by the authors."}],["$","p",null,{"children":"No specific open-access licence or permission for unrestricted commercial reuse should be assumed unless it is expressly stated in the article's licence and publication terms."}]]}]
1a:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"6. Use and Reproduction of Published Articles"}],["$","p",null,{"children":"Reuse of articles published by JPSA must comply with the copyright and licensing conditions applicable to the individual publication. Users should distinguish between reading or citing an article and reproducing or distributing substantial portions of its content."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Educational and Research Use",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Educational and Research Use"}],["$","p",null,{"children":"Use of an article for teaching, private study, research discussion, or scholarly reference may be permitted under applicable copyright exceptions or the article's licence. Users should not assume that every form of reproduction or redistribution is automatically permitted."}]]}],["$","article","Repository Deposits",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Repository Deposits"}],["$","p",null,{"children":"Depositing a manuscript or published article in an institutional or subject repository should follow the rights and conditions applicable to the relevant manuscript version and publication agreement."}]]}],["$","article","Reproduction in Other Publications",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Reproduction in Other Publications"}],["$","p",null,{"children":"Reproducing an article, substantial extracts, figures, tables, or other protected material in another publication may require permission from the relevant rights holder unless an applicable licence or legal exception permits the use."}]]}],["$","article","Commercial Reuse",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Commercial Reuse"}],["$","p",null,{"children":"Commercial redistribution, adaptation, republication, or other commercial exploitation must comply with the applicable copyright ownership and licence terms. Permission should be obtained where required."}]]}]]}],["$","p",null,{"children":"Appropriate acknowledgement should be provided whenever an article or part of an article is reused. Such acknowledgement does not replace a permission requirement where permission is legally necessary."}]]}]
1b:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"7. Copyright Infringement"}],["$","p",null,{"children":"JPSA does not permit the unauthorised reproduction or distribution of copyrighted material. Authors must ensure that their submissions do not infringe the rights of other authors, publishers, institutions, or rights holders."}],["$","p",null,{"children":"Where a possible infringement is identified, the journal may request evidence of ownership, a permission document, clarification from the author, or other relevant information."}],["$","p",null,{"children":"If an infringement is established, the journal may request replacement or removal of the affected material, suspend publication, reject the manuscript, or take appropriate post-publication corrective action."}]]}]
1c:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"8. Permissions and Requests for Reuse"}],["$","p",null,{"children":"Individuals or organisations seeking to reproduce material published by JPSA should first review the copyright and licence information associated with the article."}],["$","p",null,{"children":"Where additional permission is required, the request should identify the article, the specific material to be reproduced, the intended use, and the publication or platform in which the material will appear."}],["$","p",null,{"children":"Requests involving material owned by a third party should be directed to the relevant rights holder."}]]}]
1d:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"9. Copyright Disputes"}],["$","p",null,{"children":"Concerns regarding ownership, unauthorised reproduction, licensing, or permission should be brought to the attention of the journal's editorial office with sufficient supporting information."}],["$","p",null,{"children":"The journal may request documentation from the relevant parties and examine the matter before determining whether editorial or publication-related action is necessary."}],["$","p",null,{"children":"Where a dispute cannot be resolved through editorial clarification, the matter may require consideration by the relevant rights holders or appropriate institutional or legal authorities."}]]}]
1e:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"10. Editorial Commitment"}],["$","p",null,{"children":"JPSA expects authors and users to respect intellectual property rights and comply with the copyright terms governing submitted and published material."}],["$","p",null,{"children":"The journal aims to maintain clear publication terms, protect the rights of authors and third-party rights holders, and support responsible scholarly dissemination."}]]}]
