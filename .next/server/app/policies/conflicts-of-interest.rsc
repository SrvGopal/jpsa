13:["$","$1","c",{"children":[["$","div",null,{"className":"container page journal-content-page","children":[["$","div",null,{"className":"eyebrow","children":"PUBLICATION ETHICS"}],["$","h1",null,{"children":"Conflict of Interest Policy"}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"1. Policy Statement"}],["$","p",null,{"children":"Journal of Physical Science Advances (JPSA) expects authors, reviewers, editors, and other individuals involved in the publication process to disclose interests that could influence, or reasonably be perceived to influence, their professional judgement."}],["$","p",null,{"children":"A conflict of interest may arise when personal, financial, professional, institutional, or academic considerations interfere with an individual's ability to act objectively. Such interests may be direct or indirect and may exist even when the individual believes that their judgement has not actually been affected."}],["$","p",null,{"children":"The purpose of disclosure is to ensure transparency and allow potential conflicts to be assessed and managed appropriately. The existence of a declared conflict does not automatically imply misconduct or invalidate a research contribution."}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"2. What Constitutes a Conflict of Interest?"}],["$","p",null,{"children":"A conflict of interest exists when an individual's interests or relationships could compromise, or reasonably appear to compromise, their independence and impartiality in relation to a manuscript or editorial decision."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Financial Interests",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CATEGORY ","01"]}],["$","h3",null,{"children":"Financial Interests"}],["$","p",null,{"children":"Financial relationships that may influence or appear to influence research or editorial judgement. These may include employment, consultancy, honoraria, paid advisory roles, shareholdings, patents, royalties, research grants, or other financial benefits connected with the subject of the manuscript."}]]}],["$","article","Personal and Family Relationships",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CATEGORY ","02"]}],["$","h3",null,{"children":"Personal and Family Relationships"}],["$","p",null,{"children":"Personal relationships, family connections, close friendships, personal disputes, or other circumstances involving individuals connected with a manuscript that may affect impartial assessment."}]]}],["$","article","Professional and Institutional Relationships",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CATEGORY ","03"]}],["$","h3",null,{"children":"Professional and Institutional Relationships"}],["$","p",null,{"children":"Current or recent employment, institutional affiliation, supervisory relationships, collaborative arrangements, or professional dependencies involving an author, reviewer, editor, or another person participating in the publication process."}]]}],["$","article","Academic and Intellectual Interests",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["CATEGORY ","04"]}],["$","h3",null,{"children":"Academic and Intellectual Interests"}],["$","p",null,{"children":"Strong academic positions, direct competition, intellectual commitments, or ongoing research disputes that could affect an individual's ability to assess a manuscript objectively."}]]}],["$","article","Other Relevant Interests",{"className":"subject-area-card","children":["$L16","$L17","$L18"]}]]}],"$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],null,"$L24"]}]
14:["$","$1","h",{"children":[null,[["$","$L25",null,{"children":"$L26"}],null],["$","$L27",null,{"children":["$","div",null,{"hidden":true,"children":["$","$28",null,{"fallback":null,"children":"$L29"}]}]}]]}]
