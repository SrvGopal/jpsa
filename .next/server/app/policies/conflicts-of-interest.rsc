2c:I[5278,[],"AsyncMetadataOutlet"]
16:["$","div",null,{"className":"eyebrow","children":["CATEGORY ","05"]}]
17:["$","h3",null,{"children":"Other Relevant Interests"}]
18:["$","p",null,{"children":"Any other circumstance that could reasonably be perceived as influencing professional judgement, even where no direct financial or personal benefit is involved."}]
19:["$","p",null,{"children":"The categories above are illustrative rather than exhaustive. Individuals should disclose any other relevant circumstance where a reasonable reader might question the independence of their judgement."}]
1a:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"3. Responsibilities of Authors"}],["$","p",null,{"children":"Authors must disclose relevant competing interests at the time of manuscript submission. The declaration should be complete, accurate, and applicable to all authors listed on the manuscript."}],["$","p",null,{"children":"Relevant disclosures may include:"}],["$","ul",null,{"children":[["$","li","Relevant employment, consultancy, and paid professional relationships.",{"children":"Relevant employment, consultancy, and paid professional relationships."}],["$","li","Research funding, grants, sponsorship, and other financial support related to the work.",{"children":"Research funding, grants, sponsorship, and other financial support related to the work."}],["$","li","Financial interests, patents, royalties, or commercial relationships connected with the subject of the research.",{"children":"Financial interests, patents, royalties, or commercial relationships connected with the subject of the research."}],["$","li","Relevant personal, professional, or institutional relationships that could reasonably be perceived as influencing the research.",{"children":"Relevant personal, professional, or institutional relationships that could reasonably be perceived as influencing the research."}],["$","li","Any other interest that could affect, or appear to affect, the interpretation or presentation of the findings.",{"children":"Any other interest that could affect, or appear to affect, the interpretation or presentation of the findings."}]]}],["$","p",null,{"children":"Where no competing interests exist, authors should provide an explicit declaration stating that they have no conflicts of interest to disclose."}],["$","p",null,{"children":"Authors should not assume that a relationship is irrelevant merely because it did not directly influence the research. If the relationship could reasonably be perceived as relevant, it should be disclosed for editorial assessment."}]]}]
1b:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"4. Financial and Non-Financial Interests"}],["$","p",null,{"children":"Financial conflicts may arise from relationships involving funding, employment, consultancy, commercial interests, intellectual property, or other forms of financial benefit."}],["$","p",null,{"children":"Non-financial conflicts may arise from personal relationships, academic competition, professional rivalries, institutional responsibilities, or strongly held intellectual positions."}],["$","p",null,{"children":"Both forms of conflict are relevant to the journal's assessment. A conflict does not need to involve direct financial compensation to require disclosure."}]]}]
1c:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"5. Responsibilities of Reviewers"}],["$","p",null,{"children":"Reviewers must be able to assess a manuscript independently and without inappropriate influence. Before accepting a review invitation, reviewers should consider whether any existing relationship or competing interest could affect their impartiality."}],["$","p",null,{"children":"Reviewers are expected to:"}],["$","ul",null,{"children":[["$","li","Inform the editorial office if they have a financial, personal, professional, or academic conflict involving the manuscript or its authors.",{"children":"Inform the editorial office if they have a financial, personal, professional, or academic conflict involving the manuscript or its authors."}],["$","li","Declare current or recent collaborations, supervisory relationships, institutional connections, or direct research competition where relevant.",{"children":"Declare current or recent collaborations, supervisory relationships, institutional connections, or direct research competition where relevant."}],["$","li","Avoid reviewing a manuscript when their impartiality could reasonably be questioned.",{"children":"Avoid reviewing a manuscript when their impartiality could reasonably be questioned."}],["$","li","Maintain confidentiality and refrain from using unpublished information obtained through the review process.",{"children":"Maintain confidentiality and refrain from using unpublished information obtained through the review process."}],["$","li","Notify the editor if a potential conflict becomes apparent after accepting the review invitation.",{"children":"Notify the editor if a potential conflict becomes apparent after accepting the review invitation."}]]}],["$","p",null,{"children":"A reviewer who identifies a potential conflict should inform the handling editor promptly rather than making an independent assumption that the conflict is insignificant."}]]}]
1d:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"6. Responsibilities of Editors"}],["$","p",null,{"children":"Editors must exercise independent judgement when evaluating manuscripts and making editorial recommendations or decisions. They should disclose any interest or relationship that could compromise their ability to handle a submission impartially."}],["$","p",null,{"children":"Editors should not handle manuscripts involving close personal relationships, direct research collaborations, financial interests, or other circumstances that create a significant competing interest."}],["$","p",null,{"children":"Where a conflict is identified, the manuscript should be reassigned to an appropriate editor who can conduct the assessment independently. An editor must not use confidential manuscript information for personal research or advantage."}]]}]
1e:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"7. Disclosure and Management of Conflicts"}],["$","p",null,{"children":"Disclosure allows the journal to evaluate a potential conflict before it affects the editorial process or the interpretation of published research."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Disclosure and Assessment",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Disclosure and Assessment"}],["$","p",null,{"children":"The relevant individual should disclose the interest to the editorial office as soon as it becomes apparent. The editor will consider the nature of the relationship, its relevance to the manuscript, and whether it could affect impartiality."}]]}],["$","article","Reassignment of Review",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Reassignment of Review"}],["$","p",null,{"children":"Where a reviewer has a significant conflict, the editor may decline the review or appoint another suitably qualified reviewer. A replacement reviewer should be selected without the same relevant conflict wherever reasonably possible."}]]}],["$","article","Editorial Recusal",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Editorial Recusal"}],["$","p",null,{"children":"An editor with a relevant competing interest should not participate in the assessment or decision-making process for the affected manuscript. The manuscript may be assigned to another editor who can handle it independently."}]]}],["$","article","Disclosure in the Published Article",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Disclosure in the Published Article"}],["$","p",null,{"children":"Where a declared interest is relevant to readers' interpretation of the research, the journal may require an appropriate conflict-of-interest statement to appear in the published article."}]]}]]}],["$","p",null,{"children":"The appropriate response depends on the nature, seriousness, and relevance of the conflict. Some interests may be managed through disclosure, while others may require reassignment or withdrawal from a particular editorial role."}]]}]
1f:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"8. Conflict-of-Interest Statement in Published Articles"}],["$","p",null,{"children":"Authors may be required to include a conflict-of-interest declaration in the manuscript. Where relevant, the statement should identify the nature of the interest and provide sufficient information for readers to understand its relationship to the work."}],["$","p",null,{"children":"Where no competing interests are declared, an appropriate statement may read:"}],["$","blockquote",null,{"children":"The authors declare that they have no competing interests relevant to this work."}],["$","p",null,{"children":"Where funding or sponsorship has been received, the relevant information should also be reported accurately in the appropriate funding or acknowledgement statement."}]]}]
20:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"9. Failure to Disclose"}],["$","p",null,{"children":"Failure to disclose a relevant competing interest, whether intentional or arising from an oversight, may require editorial examination. The journal may request clarification or supporting information from the individuals concerned."}],["$","p",null,{"children":"Depending on the circumstances and the stage of publication, appropriate action may include requesting a revised disclosure, replacing a conflicted reviewer or editor, delaying editorial processing, rejecting a submission, or publishing a correction to an existing article."}],["$","p",null,{"children":"Deliberate concealment or misrepresentation of a material competing interest may be treated as a publication-ethics concern."}]]}]
21:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"10. Post-Publication Concerns"}],["$","p",null,{"children":"If a previously undisclosed conflict is identified after publication, the journal may assess whether the interest is relevant to the published work and whether readers require additional information."}],["$","p",null,{"children":"Depending on the findings, the journal may publish an additional disclosure, issue a correction, or take other appropriate action to maintain transparency in the scholarly record."}]]}]
22:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"11. Editorial Commitment"}],["$","p",null,{"children":"JPSA considers transparency in competing interests essential to maintaining confidence in scientific publication. The journal expects all participants to disclose relevant relationships honestly and cooperate with reasonable requests for clarification."}],["$","p",null,{"children":"The disclosure and management of conflicts are intended to protect the independence of peer review, the fairness of editorial decisions, and the credibility of published research."}]]}]
23:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"Related Policies"}],["$","p",null,{"children":["Authors and reviewers should also consult the journal's"," ",["$","$L2",null,{"href":"/policies/publication-ethics","children":"Publication Ethics Policy"}],","," ",["$","$L2",null,{"href":"/policies/authorship-policy","children":"Authorship Policy"}],", and"," ",["$","$L2",null,{"href":"/policies/plagiarism-policy","children":"Plagiarism Policy"}],"."]}]]}]
