16:["$","article","Self-Plagiarism and Redundant Publication",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["VIOLATION ","04"]}],["$","h3",null,{"children":"Self-Plagiarism and Redundant Publication"}],["$","p",null,{"children":"Reusing substantial portions of one's previously published work without appropriate disclosure and acknowledgement. Submitting substantially overlapping manuscripts or republishing the same research as a new contribution without transparent disclosure is not acceptable."}]]}]
17:["$","article","Unauthorized Use of Figures and Data",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["VIOLATION ","05"]}],["$","h3",null,{"children":"Unauthorized Use of Figures and Data"}],["$","p",null,{"children":"Using another researcher's figures, photographs, illustrations, tables, datasets, experimental results, or other research materials without proper acknowledgement and, where required, permission from the rights holder."}]]}]
18:["$","article","Authorship and Source Misrepresentation",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["VIOLATION ","06"]}],["$","h3",null,{"children":"Authorship and Source Misrepresentation"}],["$","p",null,{"children":"Claiming another person's intellectual contribution as one's own, concealing the original source of research material, or misrepresenting the origin, ownership, or development of submitted work."}]]}]
19:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"3. Originality and Manuscript Requirements"}],["$","p",null,{"children":"Every manuscript submitted to JPSA must represent a genuine scholarly contribution and must appropriately acknowledge the work on which it is based. Authors must not submit material that has been copied from other publications or that conceals the origin of previously published research."}],["$","p",null,{"children":"Authors are expected to distinguish clearly between their own contributions and the work of other researchers. Statements, theories, methods, experimental findings, numerical results, and interpretations derived from existing literature must be supported by appropriate references."}],["$","p",null,{"children":"Where a manuscript contains material from an author's own earlier publication, the earlier work must be acknowledged and the relationship between the two contributions must be made clear. Reuse must not create a misleading impression of new or independent research."}],["$","p",null,{"children":"Submission of a manuscript to JPSA also requires authors to disclose relevant overlapping publications and related submissions. A manuscript must not be presented as an entirely new contribution when substantially the same work has already been published or is under consideration elsewhere."}]]}]
1a:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"4. Similarity Screening and Editorial Assessment"}],["$","p",null,{"children":"Manuscripts may be examined for textual similarity as part of the journal's editorial assessment. Similarity screening is intended to identify passages that may require closer examination, including text matching published research, online material, and other available sources."}],["$","p",null,{"children":"A similarity report is an assessment aid and does not, by itself, establish the presence or absence of plagiarism. Editorial evaluation must consider the nature, location, extent, and context of the matched material."}],["$","p",null,{"children":"For example, properly cited technical terminology, standard methodological descriptions, bibliographic entries, and commonly used scientific expressions may produce text matches that do not necessarily constitute plagiarism. Conversely, a relatively small amount of copied material may represent a serious ethical violation if it involves another researcher's central findings, original interpretation, or intellectual contribution."}],["$","p",null,{"children":"Accordingly, JPSA does not treat a numerical similarity percentage as the sole basis for an editorial decision. The editorial assessment focuses on whether the manuscript demonstrates appropriate attribution and genuine scholarly originality."}]]}]
1b:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"5. Responsibilities of Authors"}],["$","p",null,{"children":"Authors bear primary responsibility for the originality and ethical integrity of the manuscripts they submit. All authors associated with a submission are expected to ensure that the work complies with the journal's plagiarism requirements."}],["$","p",null,{"children":"Authors must:"}],["$","ul",null,{"children":[["$","li","Ensure that the submitted manuscript represents original work and that all sources have been appropriately acknowledged.",{"children":"Ensure that the submitted manuscript represents original work and that all sources have been appropriately acknowledged."}],["$","li","Provide accurate citations for ideas, statements, methods, data, figures, tables, and other material obtained from external sources.",{"children":"Provide accurate citations for ideas, statements, methods, data, figures, tables, and other material obtained from external sources."}],["$","li","Use quotation marks and appropriate references when reproducing exact text from another source.",{"children":"Use quotation marks and appropriate references when reproducing exact text from another source."}],["$","li","Obtain permission for copyrighted material wherever permission is required and retain evidence of such permission.",{"children":"Obtain permission for copyrighted material wherever permission is required and retain evidence of such permission."}],["$","li","Disclose any substantial overlap with the authors' previously published work, manuscripts under consideration elsewhere, or related publications.",{"children":"Disclose any substantial overlap with the authors' previously published work, manuscripts under consideration elsewhere, or related publications."}],["$","li","Ensure that all listed references genuinely support the claims and information attributed to them.",{"children":"Ensure that all listed references genuinely support the claims and information attributed to them."}],["$","li","Cooperate with editorial enquiries concerning the originality, ownership, and provenance of submitted material.",{"children":"Cooperate with editorial enquiries concerning the originality, ownership, and provenance of submitted material."}]]}],["$","p",null,{"children":"Failure to disclose relevant overlap or provide appropriate attribution may result in editorial action, even where the material was included through an oversight or misunderstanding of citation practices."}]]}]
1c:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"6. Editorial Action in Cases of Plagiarism"}],["$","p",null,{"children":"Allegations and indications of plagiarism will be considered by the editorial team. The nature of the concern, available evidence, author explanations, and the stage of the publication process will be considered before an appropriate decision is made."}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Before publication",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Before publication"}],["$","p",null,{"children":"When potential plagiarism or substantial textual overlap is identified during initial screening or peer review, the editorial office may request an explanation, clarification, original source material, or a revised manuscript. The manuscript may be placed on hold while the concern is examined."}]]}],["$","article","Rejection of a manuscript",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Rejection of a manuscript"}],["$","p",null,{"children":"Where plagiarism or an unacceptable level of unattributed reuse is established, JPSA may reject the manuscript. Serious cases may also result in restrictions on further submissions by the responsible authors, subject to editorial review."}]]}],["$","article","After publication",{"className":"subject-area-card","children":[["$","h3",null,{"children":"After publication"}],["$","p",null,{"children":"If plagiarism is identified after publication, the journal may investigate the matter and take appropriate corrective action. Depending on the seriousness and extent of the violation, this may include publication of a correction, an expression of concern, or retraction of the article."}]]}],["$","article","Institutional notification",{"className":"subject-area-card","children":[["$","h3",null,{"children":"Institutional notification"}],["$","p",null,{"children":"In serious cases, or where further investigation is necessary, the journal may communicate with the authors' affiliated institutions, research supervisors, or other relevant authorities, where appropriate."}]]}]]}],["$","p",null,{"children":"The journal reserves the right to withhold publication while an ethical concern is under examination. The seriousness of the violation and its impact on the integrity of the scholarly record will guide the editorial response."}]]}]
1d:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"7. Plagiarism Discovered After Publication"}],["$","p",null,{"children":"Publication does not prevent the journal from examining concerns about plagiarism that arise at a later stage. Allegations concerning a published article may be investigated when supported by relevant information or evidence."}],["$","p",null,{"children":"Where an investigation establishes that an article contains plagiarism or serious unattributed material, JPSA may take corrective action to protect the accuracy and integrity of the published scholarly record."}],["$","p",null,{"children":"Depending on the circumstances, such action may include a correction, an expression of concern, or retraction. Any action taken should be communicated through an appropriate editorial notice so that readers are informed of the issue."}]]}]
1e:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"8. Allegations and Reporting Concerns"}],["$","p",null,{"children":"Researchers, readers, reviewers, and other interested individuals who identify possible plagiarism in a manuscript or published article may bring the matter to the attention of the journal's editorial office."}],["$","p",null,{"children":"Reports should include sufficient information to allow the concern to be examined, such as the title or identification of the relevant JPSA article, the suspected source material, and a description of the passages or research content in question."}],["$","p",null,{"children":"The journal may request additional documentation where necessary. Reports will be considered on the basis of the information available, and appropriate steps may be taken following editorial assessment."}]]}]
1f:["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"9. Editorial Commitment"}],["$","p",null,{"children":"JPSA considers originality, accurate attribution, and responsible research conduct essential to scholarly communication. The journal expects authors, reviewers, and editors to uphold these principles throughout the submission, review, and publication process."}],["$","p",null,{"children":"The purpose of this policy is not only to address instances of plagiarism but also to protect the reliability of the scientific literature and maintain confidence in the research published by the journal."}]]}]
