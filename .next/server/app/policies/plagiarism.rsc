13:["$","$1","c",{"children":[["$","div",null,{"className":"container page journal-content-page","children":[["$","div",null,{"className":"eyebrow","children":"PUBLICATION ETHICS"}],["$","h1",null,{"children":"Plagiarism Policy"}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"1. Policy Statement"}],["$","p",null,{"children":"Journal of Physical Science Advances (JPSA) maintains a strict position against plagiarism and all forms of unattributed appropriation of intellectual work. The journal expects every manuscript submitted for publication to demonstrate academic integrity, originality, appropriate attribution, and respect for the intellectual contributions of other researchers."}],["$","p",null,{"children":"Plagiarism, whether intentional or resulting from inadequate citation practices, is treated as a serious breach of publication ethics. Authors are responsible for ensuring that their manuscripts do not contain copied, improperly paraphrased, misrepresented, or otherwise unattributed material."}],["$","p",null,{"children":"The journal does not consider the deliberate presentation of another person's research, language, ideas, data, or intellectual contribution as original work to be acceptable. A manuscript may be rejected if an ethical violation is established, regardless of the academic qualifications, institutional affiliation, or professional position of its authors, and author may be restricted from submitting future manuscripts and will be responsible for copyright infringement and plagiarism."}]]}],["$","section",null,{"className":"journal-content-section","children":[["$","h2",null,{"children":"2. What Constitutes Plagiarism?"}],["$","p",null,{"children":"Plagiarism involves using another person's intellectual work without appropriate acknowledgement and presenting that material in a manner that misrepresents its origin or ownership. It can occur in written text as well as in research results, mathematical formulations, illustrations, experimental material, and other scholarly contributions."}],["$","p",null,{"children":"The following practices are considered unacceptable:"}],["$","div",null,{"className":"subject-area-grid","children":[["$","article","Direct Plagiarism",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["VIOLATION ","01"]}],["$","h3",null,{"children":"Direct Plagiarism"}],["$","p",null,{"children":"Reproducing sentences, paragraphs, research findings, figures, tables, or other material from another source without appropriate acknowledgement or quotation. Presenting another person's work as one's own is unacceptable, irrespective of the amount of material reproduced."}]]}],["$","article","Mosaic and Patchwork Plagiarism",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["VIOLATION ","02"]}],["$","h3",null,{"children":"Mosaic and Patchwork Plagiarism"}],["$","p",null,{"children":"Combining phrases, sentences, or passages taken from multiple sources, with only minor changes to wording or sentence structure, without proper attribution. Changing a few words or rearranging sentences does not make copied material original."}]]}],["$","article","Paraphrasing Without Attribution",{"className":"subject-area-card","children":[["$","div",null,{"className":"eyebrow","children":["VIOLATION ","03"]}],["$","h3",null,{"children":"Paraphrasing Without Attribution"}],["$","p",null,{"children":"Restating another author's ideas, arguments, interpretations, or findings in different words without acknowledging the original source. Proper paraphrasing requires both genuine re-expression and appropriate citation."}]]}],"$L16","$L17","$L18"]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}],null,"$L20"]}]
14:["$","$1","h",{"children":[null,[["$","$L21",null,{"children":"$L22"}],null],["$","$L23",null,{"children":["$","div",null,{"hidden":true,"children":["$","$24",null,{"fallback":null,"children":"$L25"}]}]}]]}]
