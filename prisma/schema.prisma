generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ADMIN
// Existing admin authentication remains separate from authors.
// ============================================================

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("EDITOR")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// BETTER AUTH
// Author-facing authentication models.
// ============================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  authorProfile AuthorProfile?
  submissions   Submission[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// AUTHOR PROFILE
// Academic information is separate from login credentials.
// ============================================================

model AuthorProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  fullName      String?
  affiliation   String?
  department    String?
  institution   String?
  country       String?
  phone         String?
  orcid         String?
  postalAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SUBMISSION
// Existing fields and admin relations are preserved.
// ============================================================

model Submission {
  id             String  @id @default(cuid())
  title          String
  authors        String
  email          String
  abstract       String  @db.Text
  keywords       String  @default("")
  articleType    String  @default("Research Article")
  manuscriptUrl  String?
  coverLetterUrl String?

  // Optional during migration to preserve existing submissions.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  status         String    @default("RECEIVED")
  editorNotes    String?   @db.Text
  decision       String?
  decisionReason String?   @db.Text
  decisionDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews         Review[]
  invoice         Invoice?
  article         Article?
  revisions       Revision[]
  coAuthors       SubmissionAuthor[]
  manuscriptFiles ManuscriptFile[]

  @@index([status, createdAt])
  @@index([email])
  @@index([ownerId, createdAt])
}

// ============================================================
// STRUCTURED SUBMISSION AUTHORS
// Co-authors do not need JPSA accounts.
// ============================================================

model SubmissionAuthor {
  id              String  @id @default(cuid())
  submissionId    String
  name            String
  email           String?
  affiliation     String?
  department      String?
  institution     String?
  country         String?
  orcid           String?
  authorOrder     Int
  isCorresponding Boolean @default(false)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, authorOrder])
  @@index([submissionId])
}

// ============================================================
// MANUSCRIPT FILES
// Tracks original manuscripts, cover letters and revisions.
// ============================================================

model ManuscriptFile {
  id               String   @id @default(cuid())
  submissionId     String
  fileType         String
  originalFilename String
  storagePath      String   @unique
  mimeType         String   @default("application/pdf")
  sizeBytes        Int
  uploadedAt       DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, fileType])
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id                   String    @id @default(cuid())
  submissionId         String
  reviewerName         String
  reviewerEmail        String
  status               String    @default("INVITED")
  recommendation       String?
  confidentialComments String?   @db.Text
  authorComments       String?   @db.Text
  invitedAt            DateTime  @default(now())
  submittedAt          DateTime?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, status])
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id            String    @id @default(cuid())
  submissionId  String    @unique
  invoiceNumber String    @unique
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("INR")
  status        String    @default("DRAFT")
  issuedAt      DateTime?
  dueAt         DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  payments Payment[]
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id             String    @id @default(cuid())
  invoiceId      String
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("INR")
  status         String    @default("PENDING")
  paymentMethod  String?
  transactionRef String?
  proofUrl       String?
  receivedAt     DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  notes          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
}

// ============================================================
// PUBLISHED ARTICLES
// ============================================================

model Article {
  id           String    @id @default(cuid())
  submissionId String?   @unique
  slug         String    @unique
  title        String
  type         String    @default("Research Article")
  authors      String
  abstract     String    @db.Text
  keywords     String    @default("")
  volume       Int
  issue        Int
  year         Int
  publishedAt  DateTime?
  doi          String?   @unique
  pdfUrl       String?
  status       String    @default("DRAFT")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([status, year])
  @@index([volume, issue, year])
}

// ============================================================
// JOURNAL ISSUES
// ============================================================

model Issue {
  id          String    @id @default(cuid())
  volume      Int
  issue       Int
  year        Int
  title       String?
  publishedAt DateTime?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([volume, issue, year])
  @@index([status, year])
}

// ============================================================
// REVISIONS
// ============================================================

model Revision {
  id           String @id @default(cuid())
  submissionId String

  round    Int
  decision String
  status   String @default("REQUESTED")

  editorComments String  @db.Text
  authorResponse String? @db.Text

  manuscriptUrl String?
  submittedAt   DateTime?
  requestedAt   DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, round])
  @@index([submissionId, status])
}
